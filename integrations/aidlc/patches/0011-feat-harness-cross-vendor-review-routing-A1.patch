+function normalizeHarnessSettings(value: unknown, where: string): HarnessSettingsRecord | undefined {
+  if (value === undefined) return undefined;
+  if (!isRecord(value)) throw new Error(`${where} must be an object`);
+  const unknown = Object.keys(value).filter((key) => !HARNESS_KEYS.has(key));
+  if (unknown.length > 0) throw new Error(`${where} contains unknown key(s): ${unknown.join(", ")}`);
+  if (value.schemaVersion !== 1) throw new Error(`${where}.schemaVersion must be 1`);
+  const out: HarnessSettingsRecord = { schemaVersion: 1 };
+  if (value.reviewDiversity !== undefined) {
+    if (value.reviewDiversity !== "auto" && value.reviewDiversity !== "off") {
+      throw new Error(`${where}.reviewDiversity must be auto or off`);
+    }
+    out.reviewDiversity = value.reviewDiversity;
+  }
+  if (value.reviewPool !== undefined) {
+    const pool = value.reviewPool;
+    if (!Array.isArray(pool) || pool.some((model) => typeof model !== "string" || !model.trim())) {
+      throw new Error(`${where}.reviewPool must be a list of model names`);
+    }
+    out.reviewPool = pool.map((model: string) => model.trim());
+  }
+  if (value.compactAtStageBoundary !== undefined) {
+    const percent = value.compactAtStageBoundary;
+    if (typeof percent !== "number" || !Number.isInteger(percent) || percent < 0 || percent > 100) {
+      throw new Error(`${where}.compactAtStageBoundary must be a whole percentage from 0 to 100`);
+    }
+    out.compactAtStageBoundary = percent;
+  }
+  return out;
+}
