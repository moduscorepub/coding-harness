+// ---------------------------------------------------------------------------
+// AI-DLC `harness` settings (machine, then project, then local layer).
+// ---------------------------------------------------------------------------
+
+export type HarnessSettings = {
+  reviewDiversity?: "auto" | "off";
+  reviewPool?: string[];
+  compactAtStageBoundary?: number;
+};
+
+function machineSettingsFile(): string {
+  const explicit = process.env.AIDLC_INSTALL_ROOT?.trim();
+  const root = explicit
+    ? resolve(explicit)
+    : process.platform === "win32"
+      ? join(process.env.LOCALAPPDATA || join(homedir(), "AppData", "Local"), "aidlc")
+      : join(process.env.XDG_DATA_HOME || join(homedir(), ".local", "share"), "aidlc");
+  return join(root, "aidlc.settings.json");
+}
+
+/** The merged `harness` section; a layer that cannot be read contributes nothing (the doctor reports it). */
+export function readHarnessSettings(cwd: string, machineFile = machineSettingsFile()): HarnessSettings {
+  const merged: HarnessSettings = {};
+  for (const file of [machineFile, join(cwd, "aidlc.settings.json"), join(cwd, "aidlc.settings.local.json")]) {
+    try {
+      const section = (JSON.parse(readFileSync(file, "utf-8")) as { harness?: unknown }).harness;
+      if (!section || typeof section !== "object") continue;
+      const { reviewDiversity, reviewPool, compactAtStageBoundary } = section as Record<string, unknown>;
+      if (reviewDiversity === "auto" || reviewDiversity === "off") merged.reviewDiversity = reviewDiversity;
+      if (Array.isArray(reviewPool)) merged.reviewPool = reviewPool.filter((model): model is string => typeof model === "string");
+      if (typeof compactAtStageBoundary === "number") merged.compactAtStageBoundary = compactAtStageBoundary;
+    } catch {
+      // Absent or unreadable layer.
+    }
+  }
+  return merged;
+}
+
+// ---------------------------------------------------------------------------
+// Cross-vendor review: a reviewer runs on another model family than the builder.
+// ---------------------------------------------------------------------------
+
+const REVIEWER_AGENTS = new Set(["aidlc-product-lead-agent", "aidlc-compliance-agent"]);
+// Harness roles a user may point at another vendor; tried after the agent's own models and the pool.
+const REVIEW_ROLE_CANDIDATES = ["@slow", "@default"];
+
+export function isReviewerAgent(agent: string): boolean {
+  return REVIEWER_AGENTS.has(agent) || /-reviewer-agent$/.test(agent);
+}
+
+/**
+ * The spawn patterns for a reviewer: the first candidate whose model family
+ * differs from the builder's goes first, the original patterns stay behind it as
+ * the retry chain. Null when the agent is no reviewer, diversity is off, or no
+ * configured model belongs to another family.
+ */
+export function reviewerRouting(
+  agent: string,
+  patterns: readonly string[],
+  models: HarnessModelQuery,
+  settings: HarnessSettings,
+): { model: string[]; note: string } | null {
+  if (!isReviewerAgent(agent) || settings.reviewDiversity === "off") return null;
+  const builder = models.current();
+  if (!builder) return null;
+  const builderFamily = models.family(builder);
+  for (const spec of new Set([...patterns, ...(settings.reviewPool ?? []), ...REVIEW_ROLE_CANDIDATES])) {
+    const model = models.resolve(spec);
+    if (!model || models.family(model) === builderFamily) continue;
+    return {
+      model: [spec, ...patterns.filter((pattern) => pattern !== spec)],
+      note: `AI-DLC review on ${model.provider}/${model.id}, a different model family than the builder's ${builder.provider}/${builder.id}`,
+    };
+  }
+  return null;
+}
