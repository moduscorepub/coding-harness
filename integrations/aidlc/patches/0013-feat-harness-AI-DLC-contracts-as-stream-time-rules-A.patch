+// ---------------------------------------------------------------------------
+// Stream rules derived from the method (host/rules carries the static contracts).
+// ---------------------------------------------------------------------------
+
+const NO_MOCKS_PRACTICE = /\b(?:no|never|don't|do not|avoid|without)\b[^\n]{0,80}\bmock/i;
+export const DERIVED_RULES_DIR = join("aidlc", ".aidlc-sessions", "harness", "rules");
+
+/** The active space's method lines that rule out mocks, labelled with their file. */
+export function noMockPractices(cwd: string): string[] {
+  const includes = readIncludes(cwd);
+  if (!includes) return [];
+  const practices: string[] = [];
+  for (const file of includes.files) {
+    for (const line of (readText(join(cwd, includes.memory, file)) ?? "").split("\n")) {
+      const text = line.replace(/<!--[\s\S]*?-->/g, "").replace(/^\s*[-*]\s+/, "").trim();
+      if (text && !text.startsWith("#") && NO_MOCKS_PRACTICE.test(text)) practices.push(`${includes.memory}/${file}: ${text}`);
+    }
+  }
+  return practices;
+}
+
+function noMocksRule(practices: string[]): string {
+  const tests = ["*.test.ts", "*.test.tsx", "*.test.js", "*.test.jsx", "*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx", "test_*.py", "*_test.py"];
+  return [
+    "---",
+    'description: "AI-DLC: the method says not to mock; tests use the real collaborator"',
+    "astCondition:",
+    ...["jest.mock($$$)", "vi.mock($$$)", "mock.module($$$)", "mock.patch($$$)", "mock.patch.object($$$)", "unittest.mock.patch($$$)", "MagicMock($$$)"].map(
+      (pattern) => `  - "${pattern}"`,
+    ),
+    `scope: "${tests.flatMap((glob) => [`tool:edit(${glob})`, `tool:write(${glob})`]).join(", ")}"`,
+    // A reminder after the write, not a refusal: a practice may allow some mocks.
+    "interruptMode: never",
+    "---",
+    "",
+    "This test mocks a collaborator, and the project's AI-DLC method says:",
+    "",
+    ...practices.map((practice) => `- ${practice}`),
+    "",
+    "Test against the real collaborator, or keep the mock only where the practice above allows it and say why.",
+    "",
+  ].join("\n");
+}
+
+/** Write (or remove) the rules derived from the method; the directory when it holds one. */
+export function writeDerivedRules(cwd: string): string | null {
+  const dir = join(cwd, DERIVED_RULES_DIR);
+  const file = join(dir, "aidlc-no-mocks.md");
+  const practices = noMockPractices(cwd);
+  try {
+    if (practices.length === 0) {
+      rmSync(file, { force: true });
+      return null;
+    }
+    const text = noMocksRule(practices);
+    if (readText(file) !== text) {
+      mkdirSync(dir, { recursive: true });
+      writeFileSync(file, text);
+    }
+    return dir;
+  } catch {
+    return null;
+  }
+}
+
