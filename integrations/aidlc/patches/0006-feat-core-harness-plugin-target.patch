+// Harness thinking level per tier, from the INSTALLED engine's tier table (the
+// same projection the shipped personas carry). Unreadable → no thinkingLevel
+// line, so the agent inherits the session default.
+const harnessThinkingByTier: Record<string, string | null> = IS_HARNESS
+  ? await import(join(HARNESS_DIR, "tools", "aidlc-tiers.ts"))
+      .then((module: { TIER_PROJECTIONS?: Record<string, { harness?: { thinkingLevel?: string | null } }> }) =>
+        Object.fromEntries(
+          Object.entries(module.TIER_PROJECTIONS ?? {}).map(([tier, row]) => [tier, row.harness?.thinkingLevel ?? null]),
+        ))
+      .catch(() => ({}))
+  : {};
+
+// A plugin persona as a Coding Harness task agent: the tier becomes
+// thinkingLevel, model access stays harness-owned (only an explicit
+// provider/model pin survives), and `disallowedTools: Task` becomes `spawns: []`.
+function emitHarnessNativeAgent({ file, content }: CopyContext): string {
+  const m = content.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n/);
+  if (!m) throw new Error(`${file}: plugin agent has no closed frontmatter block`);
+  const lines = m[1].split(/\r?\n/);
+  const tier = lines.map((line) => line.match(/^tier:\s*(\S+)\s*$/)?.[1]).find(Boolean);
+  const noSpawn = lines.some((line) => /^disallowedTools:\s*Task\s*$/i.test(line));
+  const kept = lines
+    .filter((line) => !/^(?:disallowedTools|mode|tier|effort|variant|maxTurns|thinking|thinkingLevel|spawns):/.test(line))
+    .filter((line) => {
+      const model = line.match(/^model:\s*(.*?)(?:\s+#.*)?\s*$/)?.[1];
+      return model === undefined || model.includes("/");
+    });
+  const thinking = tier ? harnessThinkingByTier[tier] : null;
+  if (thinking) kept.push(`thinkingLevel: ${thinking}`);
+  if (noSpawn) kept.push("spawns: []");
+  return content.replace(m[0], () => `---\n${kept.join("\n")}\n---\n`);
+}
