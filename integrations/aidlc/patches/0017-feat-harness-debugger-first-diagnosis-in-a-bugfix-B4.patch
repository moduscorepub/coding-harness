+"""Cart pricing. Amounts are integer cents."""
+
+
+def line_total(item):
+    return item["price_cents"] * item["qty"]
+
+
+def cart_total(items, discount_pct=0):
+    """Subtotal of the items, less a whole-number percentage discount."""
+    subtotal = sum(line_total(item) for item in items)
+    discount = subtotal * discount_pct // 10
+    return subtotal - discount
