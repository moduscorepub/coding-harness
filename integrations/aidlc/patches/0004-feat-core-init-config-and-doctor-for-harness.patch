Date: Sun, 11 Oct 2026 23:34:44 +0100
Subject: [PATCH 04/18] feat(core): init, config and doctor for harness

`aidlc init --harness harness` and model-policy commands accept the
harness distribution; first-run guidance names Coding Harness. Config
diagnostics validate harness.json for it and treat the bootstrap and adapter
as the hook-wiring trust files. The doctor checks the bootstrap, adapter,
/aidlc prompt, persona task agents and method include, warns when the
bootstrap is gitignored (the harness skips ignored extensions), probes the
full hook roster, and reads native command trust from the adapter.
---
 core/tools/aidlc-config-diagnostics.ts        | 10 ++++-
 core/tools/aidlc-doctor.ts                    |  5 ++-
 core/tools/aidlc-init.ts                      |  6 ++-
 core/tools/aidlc-utility.ts                   | 38 ++++++++++++++++++-
 .../t304-round18-acceptance-fixes.test.ts     |  1 +
 5 files changed, 56 insertions(+), 4 deletions(-)

diff --git a/core/tools/aidlc-config-diagnostics.ts b/core/tools/aidlc-config-diagnostics.ts
index 4a15063b7047aad60250d5b2732e54b836ce74eb..397ff810504ab7edabfbc6a0f2e70cae41b20976 100644
--- a/core/tools/aidlc-config-diagnostics.ts
+++ b/core/tools/aidlc-config-diagnostics.ts
@@ -490,7 +490,8 @@ export function readConfigDiagnosticRecords(harnessRoot: string): ConfigDiagnost
     distribution !== "cursor" &&
     distribution !== "kiro" &&
     distribution !== "kiro-ide" &&
-    distribution !== "opencode"
+    distribution !== "opencode" &&
+    distribution !== "harness"
   ) {
     throw new Error(`${path}: distribution must name a supported harness`);
   }
@@ -2340,6 +2341,13 @@ export function trustFilesForHarness(
   }
   if (harness === "copilot") files.push(join(projectDir, ".github", "hooks", "aidlc.json"));
   if (harness === "opencode") files.push(join(projectDir, "opencode.json"));
+  if (harness === "harness") {
+    // The bootstrap the harness auto-loads and the adapter it re-exports carry the hook wiring.
+    files.push(
+      join(projectDir, ".harness", "extensions", "aidlc.ts"),
+      join(projectDir, harnessDir, "host", "adapter.ts"),
+    );
+  }
   return [...new Set(files)];
 }
 
