+              message?: { role?: string; content?: Array<{ type?: string; text?: string; name?: string }> };
+            },
+        );
+      const at = entries.findIndex((entry) => entry.type === "compaction");
+      expect(at, "a compaction entry").toBeGreaterThan(-1);
+      expect(entries[at].details).toEqual({ source: "aidlc" });
+      expect(entries[at].summary).toContain("Current Stage: `user-stories`");
+      expect(entries[at].summary).toContain("> Run `sleep 3` with the bash tool, then reply with the single word done.");
+      // The resumed run finishes what the human asked instead of starting workflow work.
+      const after = entries
+        .slice(at + 1)
+        .filter((entry) => entry.type === "message" && entry.message?.role === "assistant")
+        .flatMap((entry) => entry.message?.content ?? []);
+      expect(after.filter((part) => part.type === "toolCall").map((part) => part.name)).toEqual([]);
+      expect(after.map((part) => part.text ?? "").join(" ").toLowerCase()).toContain("done");
     },
     10 * 60_000,
   );
