+// ---------------------------------------------------------------------------
+// State-anchored compaction: the summary is the workflow record, not a recollection.
+// ---------------------------------------------------------------------------
+
+const GATE_STATES: Record<string, string> = {
+  " ": "pending",
+  "-": "in progress",
+  "?": "awaiting approval",
+  R: "revising",
+  x: "completed",
+  S: "skipped",
+};
+// Audit events that record what the human decided, with the field that says what.
+const DECISION_FIELDS: Record<string, string[]> = {
+  GATE_APPROVED: ["User Input", "Details"],
+  GATE_REJECTED: ["Feedback", "Details"],
+  PLAN_APPROVAL_RECORDED: ["Details"],
+  QUESTION_ANSWERED: ["Details"],
+  SUMMARY_CONFIRMATION_RECORDED: ["Choice", "Details"],
+  RECOVERY_COMPLETED: ["Choice"],
+};
+const MAX_OPEN_QUESTIONS = 10;
+
+function stateField(state: string, name: string): string | null {
+  return new RegExp(`^- \\*\\*${name}\\*\\*:[ \\t]*(\\S[^\\n]*)$`, "m").exec(state)?.[1]?.trim() ?? null;
+}
+
+/** The current stage of the active intent, or null without a workflow. */
+export function currentStage(cwd: string): string | null {
+  const record = activeRecordDir(cwd);
+  return record ? stateField(readText(join(record, "aidlc-state.md")) ?? "", "Current Stage") : null;
+}
+
+function auditRows(record: string): Array<{ timestamp: string; event: string; fields: Record<string, string> }> {
+  const dir = join(record, "audit");
+  const rows: Array<{ timestamp: string; event: string; fields: Record<string, string> }> = [];
+  const shards = existsSync(dir) ? readdirSync(dir).filter(name => name.endsWith(".md")) : [];
+  for (const shard of shards) {
+    for (const block of (readText(join(dir, shard)) ?? "").split(/^---$/m)) {
+      const fields: Record<string, string> = {};
+      for (const match of block.matchAll(/^\*\*([^*\n]+)\*\*:[ \t]*([^\n]*)$/gm)) fields[match[1]] = match[2].trim();
+      if (fields.Event) rows.push({ timestamp: fields.Timestamp ?? "", event: fields.Event, fields });
+    }
+  }
+  // Shards are per clone; their rows interleave by time.
+  return rows.sort((a, b) => a.timestamp.localeCompare(b.timestamp));
+}
+
+function openQuestions(cwd: string, record: string): string[] {
+  const open: string[] = [];
+  const walk = (dir: string): void => {
+    for (const entry of readdirSync(dir, { withFileTypes: true })) {
+      const full = join(dir, entry.name);
+      if (entry.isDirectory()) {
+        if (!entry.name.startsWith(".") && entry.name !== "audit") walk(full);
+        continue;
+      }
+      if (!entry.name.endsWith("-questions.md")) continue;
+      let heading = "";
+      for (const line of (readText(full) ?? "").replace(/<!--[\s\S]*?-->/g, "").split("\n")) {
+        const title = /^#{2,4}\s+(.+)$/.exec(line);
+        if (title) heading = title[1].trim();
+        else if (/^\[Answer\]:\s*$/.test(line)) open.push(`\`${relative(cwd, full)}\`${heading ? `: ${heading}` : ""}`);
+      }
+    }
+  };
+  walk(record);
+  return open.sort();
+}
+
+function directiveLine(record: string, nextCommand: string): string {
+  const marker = parseJson(readText(join(record, ".aidlc-engine", "active-directive.json")) ?? "");
+  const run = `To continue the workflow, run \`${nextCommand}\` and do what the directive it returns says.`;
+  if (!marker || typeof marker.kind !== "string") return `None. ${run}`;
+  const what = [
+    `\`${marker.kind}\``,
+    typeof marker.ask_type === "string" ? `(${marker.ask_type})` : "",
+    typeof marker.stage === "string" ? `for \`${marker.stage}\`` : "",
+    typeof marker.unit === "string" ? `unit \`${marker.unit}\`` : "",
+    typeof marker.part === "number" && typeof marker.parts === "number" ? `part ${marker.part} of ${marker.parts}` : "",
+  ]
+    .filter(Boolean)
+    .join(" ");
+  return `${what} was in flight; the compaction cleared the parts already delivered. ${run}`;
+}
+
+const HUMAN_MESSAGES = 3;
+const HUMAN_MESSAGE_CHARS = 600;
+
+/** The human's last messages before the first kept entry, oldest first, each cut to a few hundred characters. */
+export function humanMessages(branchEntries: unknown, firstKeptEntryId: string): string[] {
+  const out: string[] = [];
+  for (const entry of Array.isArray(branchEntries) ? branchEntries : []) {
+    const record = (entry ?? {}) as { id?: unknown; type?: unknown; message?: { role?: unknown; content?: unknown } };
+    if (record.id === firstKeptEntryId) break;
+    if (record.type !== "message" || record.message?.role !== "user") continue;
+    const content = record.message.content;
+    const text = (
+      typeof content === "string"
+        ? content
+        : Array.isArray(content)
+          ? content.map(part => ((part as { type?: unknown })?.type === "text" ? String((part as { text?: unknown }).text ?? "") : "")).join("\n")
+          : ""
+    ).trim();
+    if (text) out.push(text.length > HUMAN_MESSAGE_CHARS ? `${text.slice(0, HUMAN_MESSAGE_CHARS)}…` : text);
+  }
+  return out.slice(-HUMAN_MESSAGES);
+}
+
+export type CompactionSummaryInputs = {
+  /** The engine's session-start context for a compacted session (Claude's SessionStart source=compact). */
+  sessionContext: string | null;
+  /** Project files the compacted part of the session wrote or edited. */
+  changedFiles: string[];
+  /** The engine command that returns the current directive. */
+  nextCommand: string;
+  /** What the human said in the compacted part of the session, oldest first. */
+  humanMessages: string[];
+};
+
+/** The compaction summary for the active intent, built from its record; null without one. */
+export function compactionSummary(cwd: string, inputs: CompactionSummaryInputs): { summary: string; shortSummary: string } | null {
+  const record = activeRecordDir(cwd);
+  const state = record ? readText(join(record, "aidlc-state.md")) : null;
+  const stage = state ? stateField(state, "Current Stage") : null;
+  if (!record || !state || !stage) return null;
+  const marker = new RegExp(`^- \\[([ xSR?-])\\] ${stage.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")} —`, "m").exec(state)?.[1];
+  const gate = marker !== undefined ? (GATE_STATES[marker] ?? "pending") : "unknown";
+  const phase = stateField(state, "Lifecycle Phase") ?? "unknown";
+  const list = (items: string[], none: string): string => (items.length > 0 ? items.map(item => `- ${item}`).join("\n") : none);
+  const decisions = auditRows(record)
+    .filter(row => row.event in DECISION_FIELDS)
+    .slice(-3)
+    .map(row => {
+      const said = DECISION_FIELDS[row.event].map(field => row.fields[field]).find(Boolean) ?? "";
+      const where = row.fields.Stage ?? row.fields["Current Stage"];
+      return `${row.timestamp} ${row.event}${where ? ` \`${where}\`` : ""}${said ? `: ${said.slice(0, 200)}` : ""}`;
+    });
+  const questions = openQuestions(cwd, record);
+  const sections = [
+    "# AI-DLC workflow state",
+    "This session was compacted. Carry on with what the human last asked. The workflow record below says where AI-DLC stands and outranks anything recalled from before the compaction.",
+    "## The human's latest messages before the compaction",
+    inputs.humanMessages.length > 0
+      ? inputs.humanMessages.map(text => text.split("\n").map(line => `> ${line}`.trimEnd()).join("\n")).join("\n\n")
+      : "None.",
+    "## Position",
+    list(
+      [
+        `Intent: \`${relative(cwd, record)}\``,
+        `Scope: ${stateField(state, "Scope") ?? "unknown"}`,
+        `Lifecycle Phase: ${phase}`,
+        `Current Stage: \`${stage}\` (gate: ${gate})`,
+        `Status: ${stateField(state, "Status") ?? "unknown"}`,
+        `Next Stage: ${stateField(state, "Next Stage") ?? "none"}`,
+        ...(stateField(state, "Active Unit") ? [`Active Unit: ${stateField(state, "Active Unit")}`] : []),
+      ],
+      "",
+    ),
+    "## Directive in flight",
+    directiveLine(record, inputs.nextCommand),
+    "## Human-approved artifacts",
+    list(
+      approvedArtifacts(cwd, record).map(path => `\`${path}\``),
+      "None yet.",
+    ),
+    "## Open questions",
+    list(
+      questions.length > MAX_OPEN_QUESTIONS ? [...questions.slice(0, MAX_OPEN_QUESTIONS), `${questions.length - MAX_OPEN_QUESTIONS} more`] : questions,
+      "None.",
+    ),
+    "## Recent human decisions",
+    list(decisions, "None recorded."),
+    "## Files changed in the compacted part of the session",
+    list(
+      inputs.changedFiles.map(path => `\`${path}\``),
+      "None.",
+    ),
+    ...(inputs.sessionContext ? ["## Engine context", inputs.sessionContext.trim()] : []),
+  ];
+  return { summary: `${sections.join("\n\n")}\n`, shortSummary: `AI-DLC ${phase} · ${stage} (${gate})` };
+}
+
+/** Project-relative paths the compaction's file operations wrote or edited. */
+export function changedFiles(cwd: string, fileOps: unknown): string[] {
+  const ops = fileOps && typeof fileOps === "object" ? (fileOps as Record<string, unknown>) : {};
+  const paths = new Set<string>();
+  for (const key of ["written", "edited"]) {
+    const value = ops[key];
+    for (const path of value instanceof Set || Array.isArray(value) ? value : []) {
+      if (typeof path !== "string") continue;
+      const rel = relative(cwd, resolve(cwd, path));
+      paths.add(rel.startsWith("..") || isAbsolute(rel) ? path : rel);
+    }
+  }
+  return [...paths].sort();
+}
+
