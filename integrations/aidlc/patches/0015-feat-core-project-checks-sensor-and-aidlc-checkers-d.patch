@@ -0,0 +1,20 @@
+// The project's linter: no console.log in src. `bun scripts/lint.ts [file...]`
+// checks the named files, or every src/*.ts file, and prints one
+// `file:line:col: error: message` line per finding; it exits 1 on findings.
+import { readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+
+const named = process.argv.slice(2);
+const files = named.length > 0 ? named : readdirSync("src").filter((name) => name.endsWith(".ts")).map((name) => join("src", name));
+let findings = 0;
+for (const file of files) {
+  readFileSync(file, "utf-8")
+    .split("\n")
+    .forEach((line, index) => {
+      const column = line.indexOf("console.log");
+      if (column < 0) return;
+      findings++;
+      console.log(`${file}:${index + 1}:${column + 1}: error: console.log is not allowed in src (no-console)`);
+    });
+}
+process.exit(findings > 0 ? 1 : 0);
