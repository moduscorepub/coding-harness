diff --git a/tests/integration/t-sensor-project-checks.test.ts b/tests/integration/t-sensor-project-checks.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b8b52c608f23e2aeb8eebc34b0d01b3a663bbd1a
--- /dev/null
+++ b/tests/integration/t-sensor-project-checks.test.ts
@@ -0,0 +1,212 @@
+// covers: tool:aidlc-sensor-project-checks, function:parseCheckers, function:parseCheckerOutput, function:runProjectChecks
+//
+// The project-checks sensor runs the checkers a project lists in
+// aidlc/spaces/<space>/checkers.json. In-process cases pin the config contract,
+// each parser and the run rules (matching, working directory, `{file}`,
+// project-local binaries, missing executables, timeouts); the fire cases spawn
+// the packaged dispatcher to show a finding reaches the audit and the detail file.
+
+import { afterAll, describe, expect, test } from "bun:test";
+import { spawnSync } from "node:child_process";
+import { chmodSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  type ProjectChecker,
+  parseCheckerOutput,
+  parseCheckers,
+  runProjectChecks,
+} from "../../core/tools/aidlc-sensor-project-checks.ts";
+
+const REPO_ROOT = join(import.meta.dir, "..", "..");
+const SENSOR_TS = join(REPO_ROOT, "dist", "claude", ".claude", "tools", "aidlc-sensor.ts");
+const temps: string[] = [];
+afterAll(() => {
+  for (const dir of temps) rmSync(dir, { recursive: true, force: true });
+});
+
+function project(): string {
+  const dir = mkdtempSync(join(tmpdir(), "t-project-checks-"));
+  temps.push(dir);
+  mkdirSync(join(dir, "src"), { recursive: true });
+  writeFileSync(join(dir, "src", "a.ts"), "export const a: string = 1;\n");
+  return dir;
+}
+
+const checker = (overrides: Partial<ProjectChecker>): ProjectChecker => ({ label: "c", command: ["true"], parser: "generic", ...overrides });
+
+describe("checkers.json", () => {
+  test("a valid file parses, with the generic parser by default", () => {
+    expect(
+      parseCheckers(JSON.stringify({ schemaVersion: 1, checkers: [{ label: " lint ", command: ["eslint", "{file}"], matches: "src/**" }] })),
+    ).toEqual([{ label: "lint", command: ["eslint", "{file}"], matches: "src/**", parser: "generic" }]);
+  });
+
+  test.each([
+    [{ schemaVersion: 2, checkers: [] }, "schemaVersion must be 1"],
+    [{ schemaVersion: 1 }, "checkers must be an array"],
+    [{ schemaVersion: 1, checkers: [{ label: "x", command: "eslint ." }] }, "checkers[0].command must be a non-empty argv array"],
+    [{ schemaVersion: 1, checkers: [{ label: "x", command: [""] }] }, "checkers[0].command must be a non-empty argv array"],
+    [{ schemaVersion: 1, checkers: [{ label: "x", command: ["x"], parser: "tsc" }] }, "checkers[0].parser must be one of: eslint, ruff, generic, exit-code"],
+    [{ schemaVersion: 1, checkers: [{ label: "x", command: ["x"], timeoutSeconds: 0 }] }, "checkers[0].timeoutSeconds must be a positive number"],
+    [{ schemaVersion: 1, checkers: [{ command: ["x"] }] }, "checkers[0].label must be a non-empty string"],
+  ])("%j is refused: %s", (config, message) => {
+    expect(() => parseCheckers(JSON.stringify(config))).toThrow(message);
+  });
+});
+
+describe("parsers", () => {
+  const dir = "/work/p";
+
+  test("eslint: errors fail, warnings are listed, absolute paths become project-relative", () => {
+    const stdout = `pnpm banner\n${JSON.stringify([
+      {
+        filePath: "/work/p/src/a.ts",
+        messages: [
+          { ruleId: "no-undef", severity: 2, message: "x is not defined", line: 3, column: 5 },
+          { ruleId: "prefer-const", severity: 1, message: "use const", line: 4, column: 1 },
+        ],
+      },
+    ])}`;
+    expect(parseCheckerOutput(checker({ label: "eslint", parser: "eslint" }), { status: 1, stdout, stderr: "" }, dir, dir)).toEqual([
+      { checker: "eslint", file: "src/a.ts", line: 3, column: 5, rule: "no-undef", severity: "error", message: "x is not defined" },
+      { checker: "eslint", file: "src/a.ts", line: 4, column: 1, rule: "prefer-const", severity: "warning", message: "use const" },
+    ]);
+  });
+
+  test("ruff: every finding is an error, relative to the checker's directory", () => {
+    const stdout = JSON.stringify([{ filename: "app.py", code: "F401", message: "unused import", location: { row: 1, column: 8 } }]);
+    expect(parseCheckerOutput(checker({ label: "ruff", parser: "ruff" }), { status: 1, stdout, stderr: "" }, dir, `${dir}/svc`)).toEqual([
+      { checker: "ruff", file: "svc/app.py", line: 1, column: 8, rule: "F401", severity: "error", message: "unused import" },
+    ]);
+  });
+
+  test("generic: tsc and gcc-style lines on either stream; notes are warnings", () => {
+    const result = {
+      status: 2,
+      stdout: "src/a.ts(1,14): error TS2322: Type 'number' is not assignable to type 'string'.\nFound 1 error.\n",
+      stderr: "lib/b.c:7:2: note: declared here\nlib/b.c:9:1: unused value\n",
+    };
+    expect(parseCheckerOutput(checker({ label: "tsc" }), result, dir, dir)).toEqual([
+      { checker: "tsc", file: "src/a.ts", line: 1, column: 14, rule: "TS2322", severity: "error", message: "Type 'number' is not assignable to type 'string'." },
+      { checker: "tsc", file: "lib/b.c", line: 7, column: 2, rule: "", severity: "warning", message: "declared here" },
+      { checker: "tsc", file: "lib/b.c", line: 9, column: 1, rule: "", severity: "error", message: "unused value" },
+    ]);
+  });
+
+  test("a failing run whose output no parser reads is a finding, never a clean pass", () => {
+    for (const parser of ["eslint", "ruff", "generic"] as const) {
+      expect(parseCheckerOutput(checker({ label: "x", parser }), { status: 2, stdout: "", stderr: "Oops: config not found" }, dir, dir)).toEqual([
+        { checker: "x", file: "", line: 0, column: 0, rule: "exit-2", severity: "error", message: "Oops: config not found" },
+      ]);
+    }
+    expect(parseCheckerOutput(checker({ parser: "generic" }), { status: 0, stdout: "all good", stderr: "" }, dir, dir)).toEqual([]);
+  });
+
+  test("exit-code: the exit status decides, and a failure carries the output's last lines", () => {
+    const lines = Array.from({ length: 40 }, (_, i) => `line ${i + 1}`).join("\n");
+    expect(parseCheckerOutput(checker({ parser: "exit-code" }), { status: 0, stdout: lines, stderr: "" }, dir, dir)).toEqual([]);
+    const [finding] = parseCheckerOutput(checker({ label: "tests", parser: "exit-code" }), { status: 1, stdout: lines, stderr: "" }, dir, dir);
+    expect(finding.rule).toBe("exit-1");
+    expect(finding.message.split("\n")).toEqual(Array.from({ length: 30 }, (_, i) => `line ${i + 11}`));
+  });
+});
+
+describe("running checkers", () => {
+  test("only matching checkers run; none matching means nothing to report", () => {
+    const dir = project();
+    expect(runProjectChecks(dir, [checker({ matches: "**/*.py" })], join(dir, "src", "a.ts"))).toBeNull();
+  });
+
+  test("{file} is relative to the checker's directory, which also supplies node_modules/.bin", () => {
+    const dir = project();
+    mkdirSync(join(dir, "pkg", "src"), { recursive: true });
+    mkdirSync(join(dir, "pkg", "node_modules", ".bin"), { recursive: true });
+    writeFileSync(join(dir, "pkg", "src", "b.ts"), "x\n");
+    const lint = join(dir, "pkg", "node_modules", ".bin", "fakelint");
+    writeFileSync(lint, '#!/bin/sh\necho "$1:2:3: error: no semicolon"\nexit 1\n');
+    chmodSync(lint, 0o755);
+    const result = runProjectChecks(dir, [checker({ label: "fakelint", cwd: "pkg", command: ["fakelint", "{file}"] })], join(dir, "pkg", "src", "b.ts"));
+    expect(result).toEqual({
+      pass: false,
+      findings_count: 1,
+      checkers: [{ label: "fakelint", status: "fail" }],
+      violations: [{ checker: "fakelint", file: "pkg/src/b.ts", line: 2, column: 3, rule: "", severity: "error", message: "no semicolon" }],
+    });
+  });
+
+  test("a missing executable, an escaping cwd and a timeout are reported without failing the fire", () => {
+    const dir = project();
+    const result = runProjectChecks(
+      dir,
+      [
+        checker({ label: "absent", command: ["no-such-checker-binary", "{file}"] }),
+        checker({ label: "outside", cwd: "..", command: ["true"] }),
+        checker({ label: "slow", command: ["sleep", "5"], timeoutSeconds: 0.5, parser: "exit-code" }),
+      ],
+      join(dir, "src", "a.ts"),
+    );
+    expect(result).toEqual({
+      pass: true,
+      findings_count: 0,
+      checkers: [
+        { label: "absent", status: "skipped", note: "executable not found: no-such-checker-binary" },
+        { label: "outside", status: "skipped", note: "cwd escapes the project: .." },
+        { label: "slow", status: "timeout", note: "no result within 1s" },
+      ],
+      violations: [],
+    });
+  });
+
+  test("checkers share one time budget", () => {
+    const dir = project();
+    const result = runProjectChecks(
+      dir,
+      [checker({ label: "first", command: ["sleep", "1.2"], parser: "exit-code" }), checker({ label: "second", command: ["true"] })],
+      join(dir, "src", "a.ts"),
+      1_500,
+    );
+    expect(result?.checkers).toEqual([
+      { label: "first", status: "pass" },
+      { label: "second", status: "skipped", note: "sensor time budget spent" },
+    ]);
+  });
+});
+
+describe("fired through the dispatcher", () => {
+  const fire = (dir: string) =>
+    spawnSync(process.execPath, [SENSOR_TS, "fire", "project-checks", "--stage", "code-generation", "--output-path", join(dir, "src", "a.ts")], {
+      encoding: "utf-8",
+      env: { ...process.env, CLAUDE_PROJECT_DIR: dir, AIDLC_PROJECT_DIR: dir },
+    });
+  const audit = (dir: string): string => {
+    const shards = join(dir, "aidlc", "spaces", "default", "intents", "audit");
+    return existsSync(shards) ? readdirSync(shards).map((name) => readFileSync(join(shards, name), "utf-8")).join("\n") : "";
+  };
+
+  test("a finding fails the fire and the detail file names it", () => {
+    const dir = project();
+    mkdirSync(join(dir, "aidlc", "spaces", "default"), { recursive: true });
+    writeFileSync(
+      join(dir, "aidlc", "spaces", "default", "checkers.json"),
+      JSON.stringify({
+        schemaVersion: 1,
+        checkers: [{ label: "tsc", command: ["sh", "-c", 'echo "$0(1,14): error TS2322: Type number is not string."; exit 2', "{file}"], parser: "generic" }],
+      }),
+    );
+    const result = fire(dir);
+    expect(result.status, result.stderr).toBe(0);
+    const verdict = JSON.parse(result.stdout) as { result: string; detail_path: string };
+    expect(verdict.result).toBe("failed");
+    expect(audit(dir)).toContain("**Event**: SENSOR_FAILED");
+    const detail = readFileSync(join(dir, verdict.detail_path), "utf-8");
+    expect(detail).toContain('"file": "src/a.ts"');
+    expect(detail).toContain('"rule": "TS2322"');
+  });
+
+  test("without checkers.json the fire passes as tool-unavailable", () => {
+    const dir = project();
+    const result = fire(dir);
+    expect(JSON.parse(result.stdout)).toMatchObject({ result: "passed", note: "tool-unavailable" });
+  });
+});
