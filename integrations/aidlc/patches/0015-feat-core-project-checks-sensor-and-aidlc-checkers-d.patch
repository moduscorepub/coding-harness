index 0000000000000000000000000000000000000000..130bad061caffca8e16984f1f006c6e5b8939c4c
--- /dev/null
+++ b/core/tools/aidlc-sensor-project-checks.ts
@@ -0,0 +1,352 @@
+// aidlc-sensor-project-checks.ts — per-sensor script for the `project-checks`
+// sensor (core/sensors/aidlc-project-checks.md documents the configuration).
+//
+// Runs the checkers the project lists in aidlc/spaces/<space>/checkers.json on
+// the file a stage just wrote and prints the dispatcher's stdout JSON:
+//
+//   {"pass": <bool>, "findings_count": <n>,
+//    "violations": [{checker, file, line, column, rule, severity, message}],
+//    "checkers": [{label, status: "pass"|"fail"|"skipped"|"timeout", note?}]}
+//
+// Violations come first: the failure detail file embeds this JSON as written,
+// and hosts that forward a detail excerpt to the model show its first lines.
+//
+// pass = no error-severity violation. A checker whose executable is missing is
+// skipped, and one that runs out of time is reported as a timeout; neither
+// fails the fire, because neither says anything about the written file.
+//
+// Exit codes:
+//   0   a verdict (the JSON pass field carries it)
+//   127 no checkers.json, or no checker matches the file (dispatcher: tool-unavailable)
+//   2   checkers.json is malformed (dispatcher: script-error, visible in the audit)
+//   1   bad invocation
+
+import { spawnSync } from "node:child_process";
+import { existsSync, readFileSync } from "node:fs";
+import { delimiter, isAbsolute, join, relative, resolve, sep } from "node:path";
+import { activeSpace, resolveProjectDir, resolveWorkflowSelection, spacesRoot } from "./aidlc-lib.ts";
+
+export const PROJECT_CHECK_PARSERS = ["eslint", "ruff", "generic", "exit-code"] as const;
+export type ProjectCheckParser = (typeof PROJECT_CHECK_PARSERS)[number];
+
+export interface ProjectChecker {
+	label: string;
+	command: string[];
+	cwd?: string;
+	matches?: string;
+	parser: ProjectCheckParser;
+	timeoutSeconds?: number;
+}
+
+export interface ProjectCheckViolation {
+	checker: string;
+	file: string;
+	line: number;
+	column: number;
+	rule: string;
+	severity: "error" | "warning";
+	message: string;
+}
+
+interface CheckerStatus {
+	label: string;
+	status: "pass" | "fail" | "skipped" | "timeout";
+	note?: string;
+}
+
+const DEFAULT_CHECKER_TIMEOUT_SECONDS = 30;
+// The manifest grants 120 seconds; keep headroom so the dispatcher never times
+// the whole fire out while a checker is still running.
+const SENSOR_BUDGET_MS = 110_000;
+const TAIL_LINES = 30;
+const TAIL_CHARS = 2_000;
+
+/** `aidlc/spaces/<space>/checkers.json` for the project's current space. */
+export function checkersFile(projectDir: string): string {
+	let space: string;
+	try {
+		space = resolveWorkflowSelection(projectDir).space;
+	} catch {
+		space = activeSpace(projectDir);
+	}
+	return join(spacesRoot(projectDir), space, "checkers.json");
+}
+
+/** Parse and validate checkers.json; throws with the first problem found. */
+export function parseCheckers(text: string): ProjectChecker[] {
+	const raw = JSON.parse(text) as unknown;
+	if (!raw || typeof raw !== "object" || Array.isArray(raw)) throw new Error("checkers.json must be an object");
+	const { schemaVersion, checkers } = raw as { schemaVersion?: unknown; checkers?: unknown };
+	if (schemaVersion !== 1) throw new Error("checkers.json schemaVersion must be 1");
+	if (!Array.isArray(checkers)) throw new Error("checkers.json checkers must be an array");
+	return checkers.map((entry, index) => {
+		const where = `checkers[${index}]`;
+		if (!entry || typeof entry !== "object") throw new Error(`${where} must be an object`);
+		const { label, command, cwd, matches, parser, timeoutSeconds } = entry as Record<string, unknown>;
+		if (typeof label !== "string" || !label.trim()) throw new Error(`${where}.label must be a non-empty string`);
+		if (!Array.isArray(command) || command.length === 0 || !command.every((part) => typeof part === "string") || !command[0]) {
+			throw new Error(`${where}.command must be a non-empty argv array of strings`);
+		}
+		if (cwd !== undefined && typeof cwd !== "string") throw new Error(`${where}.cwd must be a string`);
+		if (matches !== undefined && (typeof matches !== "string" || !matches)) throw new Error(`${where}.matches must be a glob string`);
+		const parserId = parser ?? "generic";
+		if (!PROJECT_CHECK_PARSERS.includes(parserId as ProjectCheckParser)) {
+			throw new Error(`${where}.parser must be one of: ${PROJECT_CHECK_PARSERS.join(", ")}`);
+		}
+		if (timeoutSeconds !== undefined && (typeof timeoutSeconds !== "number" || !(timeoutSeconds > 0))) {
+			throw new Error(`${where}.timeoutSeconds must be a positive number`);
+		}
+		return {
+			label: label.trim(),
+			command: command as string[],
+			...(cwd !== undefined ? { cwd } : {}),
+			...(matches !== undefined ? { matches } : {}),
+			parser: parserId as ProjectCheckParser,
+			...(timeoutSeconds !== undefined ? { timeoutSeconds } : {}),
+		};
+	});
+}
+
+function toPosix(path: string): string {
+	return path.split(sep).join("/");
+}
+
+function projectRelative(projectDir: string, base: string, file: string): string {
+	const rel = relative(projectDir, isAbsolute(file) ? file : resolve(base, file));
+	return rel.startsWith("..") || isAbsolute(rel) ? toPosix(file) : toPosix(rel);
+}
+
+function tail(stdout: string, stderr: string): string {
+	const lines = `${stdout}\n${stderr}`.split(/\r?\n/).filter((line) => line.trim() !== "");
+	const text = lines.slice(-TAIL_LINES).join("\n");
+	return text.length > TAIL_CHARS ? text.slice(-TAIL_CHARS) : text;
+}
+
+function jsonArray(stdout: string): unknown[] | null {
+	const start = stdout.indexOf("[");
+	if (start < 0) return null;
+	try {
+		const parsed = JSON.parse(stdout.slice(start)) as unknown;
+		return Array.isArray(parsed) ? parsed : null;
+	} catch {
+		return null;
+	}
+}
+
+const GCC_LINE = /^(.+?):(\d+):(\d+):\s*(?:(error|warning|note|info)\s*:)?\s*(.+)$/i;
+const TSC_LINE = /^(.+?)\((\d+),(\d+)\):\s*(error|warning)\s+([A-Z]+\d+):\s*(.+)$/;
+
+/** Turn one checker run into violations (file paths project-relative). */
+export function parseCheckerOutput(
+	checker: ProjectChecker,
+	result: { status: number | null; stdout: string; stderr: string },
+	projectDir: string,
+	checkerCwd: string,
+): ProjectCheckViolation[] {
+	const label = checker.label;
+	const failure = (): ProjectCheckViolation[] =>
+		result.status === 0
+			? []
+			: [{
+				checker: label,
+				file: "",
+				line: 0,
+				column: 0,
+				rule: `exit-${result.status}`,
+				severity: "error",
+				message: tail(result.stdout, result.stderr) || `${label} exited ${result.status}`,
+			}];
+	if (checker.parser === "exit-code") return failure();
+	if (checker.parser === "eslint" || checker.parser === "ruff") {
+		const entries = jsonArray(result.stdout);
+		if (!entries) return failure();
+		const out: ProjectCheckViolation[] = [];
+		for (const entry of entries as Array<Record<string, unknown>>) {
+			if (checker.parser === "eslint") {
+				for (const message of (entry.messages as Array<Record<string, unknown>> | undefined) ?? []) {
+					out.push({
+						checker: label,
+						file: projectRelative(projectDir, checkerCwd, String(entry.filePath ?? "")),
+						line: Number(message.line ?? 0),
+						column: Number(message.column ?? 0),
+						rule: String(message.ruleId ?? ""),
+						severity: message.severity === 2 || message.fatal === true ? "error" : "warning",
+						message: String(message.message ?? ""),
+					});
+				}
+			} else {
+				const location = (entry.location ?? {}) as Record<string, unknown>;
+				out.push({
+					checker: label,
+					file: projectRelative(projectDir, checkerCwd, String(entry.filename ?? "")),
+					line: Number(location.row ?? 0),
+					column: Number(location.column ?? 0),
+					rule: String(entry.code ?? ""),
+					severity: "error",
+					message: String(entry.message ?? ""),
+				});
+			}
+		}
+		return out;
+	}
+	const out: ProjectCheckViolation[] = [];
+	for (const line of `${result.stdout}\n${result.stderr}`.split(/\r?\n/)) {
+		const tsc = TSC_LINE.exec(line.trim());
+		if (tsc) {
+			out.push({
+				checker: label,
+				file: projectRelative(projectDir, checkerCwd, tsc[1]),
+				line: Number(tsc[2]),
+				column: Number(tsc[3]),
+				rule: tsc[5],
+				severity: tsc[4] === "warning" ? "warning" : "error",
+				message: tsc[6],
+			});
+			continue;
+		}
+		const gcc = GCC_LINE.exec(line.trim());
+		if (gcc) {
+			const level = gcc[4]?.toLowerCase();
+			out.push({
+				checker: label,
+				file: projectRelative(projectDir, checkerCwd, gcc[1]),
+				line: Number(gcc[2]),
+				column: Number(gcc[3]),
+				rule: "",
+				severity: level === undefined || level === "error" ? "error" : "warning",
+				message: gcc[5],
+			});
+		}
+	}
+	// A failing run that printed nothing recognisable must not read as clean.
+	return out.length > 0 ? out : failure();
+}
+
+function checkerEnv(cwd: string): NodeJS.ProcessEnv {
+	const local = [join(cwd, "node_modules", ".bin"), join(cwd, ".venv", "bin")].filter((dir) => existsSync(dir));
+	return { ...process.env, PATH: [...local, process.env.PATH ?? ""].join(delimiter) };
+}
+
+export interface ProjectChecksResult {
+	pass: boolean;
+	findings_count: number;
+	violations: ProjectCheckViolation[];
+	checkers: CheckerStatus[];
+}
+
+/** Run every checker that matches `filePath`; null when none applies. */
+export function runProjectChecks(
+	projectDir: string,
+	checkers: ProjectChecker[],
+	filePath: string,
+	budgetMs = SENSOR_BUDGET_MS,
+): ProjectChecksResult | null {
+	const absFile = resolve(filePath);
+	const relFile = toPosix(relative(projectDir, absFile));
+	const applicable = checkers.filter((checker) => !checker.matches || new Bun.Glob(checker.matches).match(relFile));
+	if (applicable.length === 0) return null;
+	const statuses: CheckerStatus[] = [];
+	const violations: ProjectCheckViolation[] = [];
+	const deadline = Date.now() + budgetMs;
+	for (const checker of applicable) {
+		const cwd = resolve(projectDir, checker.cwd ?? ".");
+		const inside = relative(projectDir, cwd);
+		if (inside.startsWith("..") || isAbsolute(inside)) {
+			statuses.push({ label: checker.label, status: "skipped", note: `cwd escapes the project: ${checker.cwd}` });
+			continue;
+		}
+		const remaining = deadline - Date.now();
+		if (remaining < 1_000) {
+			statuses.push({ label: checker.label, status: "skipped", note: "sensor time budget spent" });
+			continue;
+		}
+		const timeoutMs = Math.min((checker.timeoutSeconds ?? DEFAULT_CHECKER_TIMEOUT_SECONDS) * 1000, remaining);
+		const fileArg = toPosix(relative(cwd, absFile)) || ".";
+		const [binary, ...args] = checker.command.map((part) => part.split("{file}").join(fileArg));
+		const env = checkerEnv(cwd);
+		const executable = /[\\/]/.test(binary) ? resolve(cwd, binary) : (Bun.which(binary, { PATH: env.PATH ?? "" }) ?? null);
+		if (!executable || !existsSync(executable)) {
+			statuses.push({ label: checker.label, status: "skipped", note: `executable not found: ${binary}` });
+			continue;
+		}
+		const result = spawnSync(executable, args, { cwd, env, encoding: "utf-8", timeout: timeoutMs, maxBuffer: 16 * 1024 * 1024 });
+		const timedOut =
+			(result.error as NodeJS.ErrnoException | undefined)?.code === "ETIMEDOUT" ||
+			(result.status === null && result.signal === "SIGTERM");
+		if (timedOut) {
+			statuses.push({ label: checker.label, status: "timeout", note: `no result within ${Math.round(timeoutMs / 1000)}s` });
+			continue;
+		}
+		if (result.error) {
+			statuses.push({ label: checker.label, status: "skipped", note: `could not run: ${result.error.message}` });
+			continue;
+		}
+		const found = parseCheckerOutput(
+			checker,
+			{ status: result.status, stdout: result.stdout ?? "", stderr: result.stderr ?? "" },
+			projectDir,
+			cwd,
+		);
+		violations.push(...found);
+		statuses.push({ label: checker.label, status: found.some((v) => v.severity === "error") ? "fail" : "pass" });
+	}
+	const errors = violations.filter((v) => v.severity === "error").length;
+	return { pass: errors === 0, findings_count: errors, violations, checkers: statuses };
+}
+
+// --- CLI ----------------------------------------------------------------------
+
+function printHelp(): void {
+	process.stdout.write(
+		"Usage: aidlc-sensor-project-checks --stage <slug> --file-path <path>\n\n" +
+			"Runs the checkers in aidlc/spaces/<space>/checkers.json that match <path>\n" +
+			"and prints {pass, findings_count, checkers[], violations[]} JSON to stdout.\n",
+	);
+}
+
+export function main(argv: string[]): void {
+	let stage = "";
+	let filePath = "";
+	for (let i = 0; i < argv.length; i++) {
+		const arg = argv[i];
+		if (arg === "--stage") stage = argv[++i] ?? "";
+		else if (arg === "--file-path") filePath = argv[++i] ?? "";
+		else if (arg === "--help" || arg === "-h") {
+			printHelp();
+			process.exit(0);
+		} else {
+			process.stderr.write(`unknown flag: ${arg}\n`);
+			process.exit(1);
+		}
+	}
+	if (!stage || !filePath) {
+		process.stderr.write("missing required flag: --stage and --file-path are both required\n");
+		process.exit(1);
+	}
+	if (!existsSync(filePath)) {
+		process.stderr.write(`file-path not found: ${filePath}\n`);
+		process.exit(1);
+	}
+	const projectDir = resolveProjectDir();
+	const file = checkersFile(projectDir);
+	if (!existsSync(file)) {
+		process.stderr.write("no-checkers\n");
+		process.exit(127);
+	}
+	let checkers: ProjectChecker[];
+	try {
+		checkers = parseCheckers(readFileSync(file, "utf-8"));
+	} catch (error) {
+		process.stderr.write(`checkers-config-error: ${relative(projectDir, file)}: ${(error as Error).message}\n`);
+		process.exit(2);
+	}
+	const result = runProjectChecks(projectDir, checkers, filePath);
+	if (!result) {
+		process.stderr.write("no-matching-checker\n");
+		process.exit(127);
+	}
+	process.stdout.write(`${JSON.stringify(result)}\n`);
+	process.exit(0);
+}
+
+if (import.meta.main) main(process.argv.slice(2));
