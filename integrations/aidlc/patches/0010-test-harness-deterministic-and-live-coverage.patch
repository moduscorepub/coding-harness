+// covers: file:skills/aidlc/SKILL.md
+//
+// t-harness-coexistence-live.serial.test.ts — S16: one project configured for
+// both Claude Code and Coding Harness (Claude first, as an existing Claude
+// project adopting the harness would be). Each host runs AI-DLC through its own
+// distribution:
+//   - Coding Harness: `/aidlc` resolves to the harness skill rather than the
+//     Claude copy it also discovers under .claude/skills, and no framework
+//     command it runs touches .claude/, up to the first question inside the
+//     created workflow;
+//   - Claude Code: `/aidlc --doctor` passes and checks the Claude distribution,
+//     on the workflow the harness started.
+//
+// Both release projections run framework commands through the native `aidlc`,
+// so the installed `aidlc` must carry the harness distribution.
+//
+// LIVE GATE: AIDLC_HARNESS_RPC_LIVE=1 with the harness live prerequisites (see
+// t-rpc-harness-live), plus the `claude` CLI and a Claude credential for the
+// Agent SDK.
+
+import { afterAll, describe, expect, test } from "bun:test";
+import { spawnSync } from "node:child_process";
+import { cpSync, existsSync, mkdtempSync, readFileSync, realpathSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DEFAULT_SPACE, intentsDirOf } from "../harness/fixtures.ts";
+import { HarnessRpc } from "../harness/harness-rpc.ts";
+import { driveAidlc } from "../harness/sdk-drive.ts";
+
+const REPO_ROOT = join(import.meta.dir, "..", "..");
+const LIVE = process.env.AIDLC_HARNESS_RPC_LIVE === "1";
+const BIN = process.env.AIDLC_HARNESS_BIN ?? Bun.which("harness") ?? "";
+const KEY = process.env.AIDLC_HARNESS_ANTHROPIC_KEY ?? process.env.ANTHROPIC_API_KEY ?? "";
+const HARNESS_MODEL = process.env.AIDLC_HARNESS_MODEL ?? "anthropic/claude-sonnet-5-5";
+const CLAUDE_MODEL = process.env.AIDLC_PARITY_CLAUDE_MODEL ?? "claude-sonnet-5-5";
+
+const ENABLED =
+  LIVE &&
+  KEY !== "" &&
+  BIN !== "" &&
+  existsSync(BIN) &&
+  Bun.which("claude") !== null &&
+  existsSync(join(REPO_ROOT, "dist-release", "harness")) &&
+  existsSync(join(REPO_ROOT, "dist-release", "claude"));
+const live = ENABLED ? test : test.skip;
+
+const scratch: string[] = [];
+afterAll(() => {
+  for (const dir of scratch.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function tempDir(prefix: string): string {
+  const dir = realpathSync(mkdtempSync(join(tmpdir(), prefix)));
+  scratch.push(dir);
+  return dir;
+}
+
+/** The fixture library, configured for Claude Code and then for Coding Harness. */
+function coexistingProject(): string {
+  const dir = tempDir("t-coexist-");
+  cpSync(join(REPO_ROOT, "tests", "fixtures", "bugfix-invoice"), dir, { recursive: true });
+  spawnSync("git", ["init", "-q"], { cwd: dir });
+  for (const harness of ["claude", "harness"]) {
+    const configured = spawnSync(
+      process.execPath,
+      [
+        join(REPO_ROOT, "core", "tools", "aidlc-init.ts"),
+        "config",
+        "--project-dir",
+        dir,
+        "--from",
+        join(REPO_ROOT, "dist-release", harness),
+        "--harness",
+        harness,
+        "--mcp",
+        "none",
+      ],
+      { cwd: dir, encoding: "utf-8", timeout: 120_000 },
+    );
+    if (configured.status !== 0) throw new Error(`config --harness ${harness}: ${configured.stdout}${configured.stderr}`);
+  }
+  return dir;
+}
+
+function commandOf(call: { args: unknown }): string {
+  return String((call.args as { command?: unknown } | undefined)?.command ?? "");
+}
+
+describe("t-harness-coexistence-live", () => {
+  live(
+    "S16: Claude Code and Coding Harness each run AI-DLC from their own distribution in one project",
+    async () => {
+      const dir = coexistingProject();
+      const registry = join(intentsDirOf(dir, DEFAULT_SPACE), "intents.json");
+      const hasIntent = () => existsSync(registry) && readFileSync(registry, "utf-8").includes('"scope"');
+
+      const rpc = new HarnessRpc({
+        bin: BIN,
+        cwd: dir,
+        args: ["--approval-mode", "yolo", "--model", HARNESS_MODEL],
+        env: { ANTHROPIC_API_KEY: KEY, PI_CODING_AGENT_DIR: tempDir("t-coexist-agent-") },
+      });
+      await rpc.start();
+      let workflowAsked = false;
+      const outcome = await rpc.prompt(
+        "/aidlc --scope bugfix total() in src/invoice.ts subtracts the discount percentage as if it were cents",
+        {
+          stopWhen: (frame) => {
+            if (frame.type === "extension_ui_request" && frame.method === "ask" && hasIntent()) workflowAsked = true;
+            return workflowAsked && frame.type === "tool_execution_end" && frame.toolName === "ask";
+          },
+        },
+      );
+      await rpc.close();
+
+      expect(hasIntent(), "the harness created the workflow").toBe(true);
+      const touched = outcome.toolCalls.map((call) => JSON.stringify(call.args ?? {}));
+      expect(touched.filter((args) => args.includes(".claude/skills/aidlc")), "the Claude skill was read").toEqual([]);
+      const engine = outcome.toolCalls
+        .filter((call) => call.toolName === "bash" && !call.isError)
+        .map(commandOf)
+        .filter((command) => /^aidlc\s|\/(?:tools|hooks)\/aidlc[a-z-]*\.ts/.test(command.trim()));
+      expect(engine.length, "framework commands ran").toBeGreaterThan(0);
+      expect(engine.filter((command) => command.includes(".claude/")), engine.join("\n")).toEqual([]);
+
+      const doctor = await driveAidlc("/aidlc --doctor", {
+        projectDir: dir,
+        model: CLAUDE_MODEL,
+        timeoutMs: 10 * 60_000,
+      });
+      const report = doctor.toolResults.find((result) => result.resultText.includes("AI-DLC doctor"));
+      expect(report?.resultText).toContain("Project (.claude, Claude Code)");
+      expect(report?.resultText).toMatch(/\b0 problems\b/);
+    },
+    30 * 60_000,
+  );
+});
