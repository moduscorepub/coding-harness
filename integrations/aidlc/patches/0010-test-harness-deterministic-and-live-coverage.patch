+// t-harness-usage-reader: Coding Harness session transcripts feed the AI-DLC
+// usage ledger. A harness session is the main JSONL plus the transcripts in its
+// artifacts directory: task subagents named by the task `name`, their own
+// children one directory deeper, and advisors. Every LLM call is one `message`
+// line keyed by responseId. The reader must count each call once, attribute
+// subagents to the agent their parent's task call named, price models the rate
+// table knows and keep the harness-reported cost for the rest, and an
+// incremental (holdback) fold must land on the same totals as a whole read.
+//
+// covers: function:readHarnessSession, function:harnessSubagentFiles, function:harnessAgentTypes, function:isHarnessSessionTranscript, function:readTranscript, function:foldTranscriptIntoLedger
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { appendFileSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  foldTranscriptIntoLedger,
+  harnessAgentTypes,
+  harnessSubagentFiles,
+  readTranscript,
+  type UsageRow,
+} from "../../core/tools/aidlc-usage.ts";
+
+const scratch: string[] = [];
+afterEach(() => {
+  for (const dir of scratch.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function line(message: Record<string, unknown>): string {
+  return `${JSON.stringify({ type: "message", id: crypto.randomUUID(), timestamp: "2026-10-11T00:00:00Z", message })}\n`;
+}
+
+function header(id: string, cwd: string): string {
+  return `${JSON.stringify({ type: "title", title: id })}\n${JSON.stringify({ type: "session", version: 3, id, cwd })}\n`;
+}
+
+function assistant(
+  responseId: string,
+  model: string,
+  usage: { input: number; output: number; cacheRead?: number; cacheWrite?: number; oneHour?: number; cost?: number },
+  content: unknown[] = [{ type: "text", text: "ok" }],
+): string {
+  return line({
+    role: "assistant",
+    model,
+    responseId,
+    content,
+    usage: {
+      input: usage.input,
+      output: usage.output,
+      cacheRead: usage.cacheRead ?? 0,
+      cacheWrite: usage.cacheWrite ?? 0,
+      ...(usage.oneHour ? { cttl: { ephemeral1h: usage.oneHour } } : {}),
+      cost: { total: usage.cost ?? 0 },
+    },
+  });
+}
+
+/**
+ * The harness layout: task subagents named by the task `name` in the session's
+ * artifacts dir (a repeated name gets `-2`), a nested child in the subagent's
+ * own artifacts dir with the dotted parent prefix, and advisors at both levels.
+ */
+function session(): { dir: string; main: string } {
+  const dir = mkdtempSync(join(tmpdir(), "t-harness-usage-"));
+  scratch.push(dir);
+  const main = join(dir, "2026-10-11T00-00-00-000Z_abc.jsonl");
+  writeFileSync(
+    main,
+    header("abc", dir) +
+      line({ role: "user", content: [{ type: "text", text: "review the design" }] }) +
+      assistant("r1", "claude-sonnet-4-6", { input: 1000, output: 200, cacheRead: 5000, cacheWrite: 400, oneHour: 100 }, [
+        {
+          type: "toolCall",
+          id: "c1",
+          name: "task",
+          arguments: {
+            tasks: [
+              { name: "Review", agent: "aidlc-architecture-reviewer-agent", task: "x" },
+              { name: "Review", agent: "aidlc-architecture-reviewer-agent", task: "x again" },
+            ],
+          },
+        },
+      ]) +
+      line({ role: "toolResult", toolCallId: "c1", toolName: "task", content: [{ type: "text", text: "done" }] }) +
+      assistant("r2", "gpt-5.5", { input: 300, output: 50, cost: 0.0125 }),
+  );
+  const artifacts = join(dir, "2026-10-11T00-00-00-000Z_abc");
+  mkdirSync(join(artifacts, "Review"), { recursive: true });
+  writeFileSync(
+    join(artifacts, "Review.jsonl"),
+    header("sub", dir) +
+      assistant("s1", "claude-sonnet-4-6", { input: 700, output: 90 }, [
+        { type: "toolCall", id: "c2", name: "task", arguments: { name: "Probe", agent: "aidlc-developer-agent", task: "y" } },
+      ]),
+  );
+  writeFileSync(join(artifacts, "Review-2.jsonl"), header("sub2", dir) + assistant("s2", "claude-sonnet-4-6", { input: 60, output: 6 }));
+  writeFileSync(
+    join(artifacts, "Review", "Review.Probe.jsonl"),
+    header("probe", dir) + assistant("p1", "claude-haiku-4-5", { input: 40, output: 10 }),
+  );
+  writeFileSync(
+    join(artifacts, "Review", "__advisor.jsonl"),
+    header("sub-advisor", dir) + assistant("a2", "claude-haiku-4-5", { input: 4, output: 1 }),
+  );
+  writeFileSync(join(artifacts, "__advisor.jsonl"), header("advisor", dir) + assistant("a1", "claude-sonnet-4-6", { input: 20, output: 5 }));
+  writeFileSync(
+    join(artifacts, "__advisor.watchdog.jsonl"),
+    header("watchdog", dir) + assistant("w1", "claude-haiku-4-5", { input: 2, output: 1 }),
+  );
+  return { dir, main };
+}
+
+const sum = (rows: UsageRow[], key: "input" | "output" | "cacheRead") =>
+  rows.reduce((total, row) => total + row.counts[key], 0);
+
+describe("harness session usage", () => {
+  test("every call is counted once and attributed to the agent that made it", () => {
+    const { main } = session();
+    const rows = readTranscript(main);
+    expect(rows.map((row) => [row.agentId, row.agentType, row.msgId])).toEqual([
+      [null, "main", "r1"],
+      [null, "main", "r2"],
+      ["Review-2", "aidlc-architecture-reviewer-agent", "s2"],
+      ["Review", "aidlc-architecture-reviewer-agent", "s1"],
+      ["Review/Review.Probe", "aidlc-developer-agent", "p1"],
+      ["Review/__advisor", "advisor", "a2"],
+      ["__advisor", "advisor", "a1"],
+      ["__advisor.watchdog", "advisor", "w1"],
+    ]);
+    expect(sum(rows, "input")).toBe(1000 + 300 + 60 + 700 + 40 + 4 + 20 + 2);
+    expect(sum(rows, "output")).toBe(200 + 50 + 6 + 90 + 10 + 1 + 5 + 1);
+    expect(rows[0].counts).toEqual({ input: 1000, output: 200, cacheCreate5m: 300, cacheCreate1h: 100, cacheRead: 5000 });
+  });
+
+  test("models outside the rate table keep the cost the harness reported", () => {
+    const { main } = session();
+    const rows = readTranscript(main);
+    expect(rows.find((row) => row.msgId === "r2")?.usd).toBe(0.0125);
+    // sonnet-4-6 per Mtok: 3 input, 15 output, 3.75 5m write, 6 1h write, 0.3 read.
+    expect(rows.find((row) => row.msgId === "r1")?.usd).toBeCloseTo(
+      (1000 * 3 + 200 * 15 + 300 * 3.75 + 100 * 6 + 5000 * 0.3) / 1e6,
+      10,
+    );
+  });
+
+  test("subagent discovery follows nested delegation and names advisors", () => {
+    const { main } = session();
+    const files = harnessSubagentFiles(main);
+    expect(harnessAgentTypes(main, files)).toEqual({
+      "Review-2": "aidlc-architecture-reviewer-agent",
+      Review: "aidlc-architecture-reviewer-agent",
+      "Review/Review.Probe": "aidlc-developer-agent",
+      "Review/__advisor": "advisor",
+      __advisor: "advisor",
+      "__advisor.watchdog": "advisor",
+    });
+  });
+
+  test("an incremental fold reaches the whole-session totals once the turn ends", () => {
+    const { dir, main } = session();
+    const project = join(dir, "project");
+    mkdirSync(project, { recursive: true });
+    // Mid-turn folds hold back each file's last call; more calls arrive; Stop flushes.
+    foldTranscriptIntoLedger(project, main, "requirements-analysis", "holdback", { sessionId: "abc" });
+    appendFileSync(main, assistant("r3", "claude-sonnet-4-6", { input: 11, output: 3 }));
+    foldTranscriptIntoLedger(project, main, "requirements-analysis", "holdback", { sessionId: "abc" });
+    const ledger = foldTranscriptIntoLedger(project, main, "requirements-analysis", "flush-all", { sessionId: "abc" });
+
+    const rows = readTranscript(main);
+    expect(ledger.totals.tokens.input).toBe(sum(rows, "input"));
+    expect(ledger.totals.tokens.output).toBe(sum(rows, "output"));
+    expect(ledger.totals.tokens.cacheRead).toBe(sum(rows, "cacheRead"));
+    expect(Object.keys(ledger.byAgent).sort()).toEqual(
+      ["advisor", "aidlc-architecture-reviewer-agent", "aidlc-developer-agent", "main"].sort(),
+    );
+    // A second flush with nothing new changes nothing.
+    const again = foldTranscriptIntoLedger(project, main, "requirements-analysis", "flush-all", { sessionId: "abc" });
+    expect(again.totals.tokens.input).toBe(ledger.totals.tokens.input);
+  });
+});
