+    "S2: an edit before the code-generation plan is approved is refused with the guard's reason",
+    async () => {
+      const dir = seededProject("code-generation");
+      const state = readFileSync(seededStateFile(dir), "utf-8");
+      writeActiveDirectiveMarker(dir, { kind: "run-stage", stage: "code-generation", unit: "unit-a", state_sha256: stateDigest(state) });
+      mkdirSync(join(seededRecordDir(dir), "construction", "unit-a", "code-generation"), { recursive: true });
+      const rpc = session(dir);
+      await rpc.start();
+      const outcome = await rpc.prompt(
