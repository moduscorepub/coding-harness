+} from "../harness/fixtures.ts";
+
+const REPO_ROOT = join(import.meta.dir, "..", "..");
+const DIST = join(REPO_ROOT, "dist", "harness");
+const SESSION_ID = "01a1267b-c036-7000-ba97-5ff01173ec9d";
+const PINNED_CLONE_ID = "testcloneidharness";
+
+type Handler = (event: Record<string, unknown>, ctx: Record<string, unknown>) => unknown;
+type AdapterModule = {
+  default: (pi: { on: (event: string, handler: Handler) => void; sendMessage?: unknown }) => void;
+};
+
+let adapterModule: AdapterModule;
+beforeAll(async () => {
+  adapterModule = (await import(join(DIST, ".harness-aidlc", "host", "adapter.ts"))) as AdapterModule;
+});
+
+const scratch: string[] = [];
+afterEach(() => {
+  for (const dir of scratch.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function shardName(): string {
+  const host =
+    hostname()
+      .toLowerCase()
+      .replace(/[^a-z0-9-]+/g, "-")
+      .replace(/^-+|-+$/g, "")
+      .slice(0, 48) || "host";
+  return `${host}-${PINNED_CLONE_ID}.md`;
+}
+
+/** A harness project: the dist shell plus the brownfield-feature workflow state. */
+function project(): { dir: string; sessionFile: string } {
+  const dir = realpathSync(mkdtempSync(join(tmpdir(), "t-harness-contract-")));
+  scratch.push(dir);
+  cpSync(DIST, dir, { recursive: true });
+  const intentsDir = intentsDirOf(dir, DEFAULT_SPACE);
+  mkdirSync(seededRecordDir(dir), { recursive: true });
+  writeFileSync(join(intentsDir, "active-intent"), `${DEFAULT_RECORD_DIR}\n`, "utf-8");
+  writeFileSync(
+    join(intentsDir, "intents.json"),
+    `${JSON.stringify(
+      [{ uuid: "00000000-0000-7000-8000-000000000001", slug: DEFAULT_RECORD_DIR.replace(/-[0-9a-f]+$/, ""), status: "in-flight" }],
+      null,
+      2,
+    )}\n`,
+    "utf-8",
+  );
+  writeFileSync(
+    seededStateFile(dir),
+    readFileSync(join(REPO_ROOT, "tests", "fixtures", "state-brownfield-feature.md"), "utf-8"),
+  );
+  writeFileSync(join(dir, "aidlc", ".aidlc-clone-id"), `${PINNED_CLONE_ID}\n`, "utf-8");
+  mkdirSync(seededAuditDir(dir), { recursive: true });
+  writeFileSync(join(seededAuditDir(dir), shardName()), "# AI-DLC Audit Log\n");
+  const sessions = join(dir, ".sessions");
+  mkdirSync(sessions, { recursive: true });
+  const sessionFile = join(sessions, `2026-10-11T00-00-00-000Z_${SESSION_ID}.jsonl`);
+  writeFileSync(
+    sessionFile,
+    `${JSON.stringify({ type: "title", title: "t" })}\n${JSON.stringify({ type: "session", version: 3, id: SESSION_ID, cwd: dir })}\n`,
+  );
+  writeSessionPidEntry(dir, process.pid, SESSION_ID);
+  return { dir, sessionFile };
+}
+
+function audit(dir: string): string {
+  const auditDir = seededAuditDir(dir);
+  return readdirSync(auditDir)
+    .filter((name) => name.endsWith(".md"))
+    .map((name) => readFileSync(join(auditDir, name), "utf-8"))
+    .join("\n");
+}
+
+function count(text: string, needle: string): number {
+  return text.split(needle).length - 1;
+}
+
+/** Load the shipped adapter against a fake extension API; returns an event emitter. */
+function harness(dir: string, sessionFile: string, kind: "main" | "sub" = "main") {
+  const handlers = new Map<string, Handler[]>();
+  adapterModule.default({
+    on: (event, handler) => handlers.set(event, [...(handlers.get(event) ?? []), handler]),
+    sendMessage: () => {},
+  });
+  const ctx = {
+    cwd: dir,
+    hasUI: false,
+    agent: { kind, id: kind === "main" ? "main" : "0-Review", name: kind === "main" ? "main" : "aidlc-architecture-reviewer-agent" },
+    sessionManager: { getSessionFile: () => sessionFile, getSessionId: () => SESSION_ID },
+  };
+  return async (event: string, payload: Record<string, unknown>): Promise<unknown> => {
+    let result: unknown;
+    for (const handler of handlers.get(event) ?? []) result = (await handler(payload, ctx)) ?? result;
+    return result;
+  };
+}
+
+function appendTranscript(sessionFile: string, entries: Array<Record<string, unknown>>): void {
+  writeFileSync(
+    sessionFile,
+    readFileSync(sessionFile, "utf-8") +
+      entries.map((message) => `${JSON.stringify({ type: "message", id: crypto.randomUUID(), message })}\n`).join(""),
+  );
+}
