diff --git a/tests/unit/t-harness-adapter-map.test.ts b/tests/unit/t-harness-adapter-map.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..28f24288bac5ad080b1b95b882f90a73442b06c8
--- /dev/null
+++ b/tests/unit/t-harness-adapter-map.test.ts
@@ -0,0 +1,362 @@
+// t-harness-adapter-map: the Coding Harness adapter's event → core-hook mapping,
+// exercised through its runCore seam (no subprocesses). Covers the decisions the
+// adapter itself makes: which hooks run for which tool and agent, how a hook's
+// exit 2 becomes a blocked tool call, how task assignments are rewritten for
+// batch dispatch, and what never reaches a hook (main-only events in subagents,
+// chained framework shell commands).
+//
+// covers: function:claudeCalls, function:taskItems, function:withTaskAssignments, function:withoutRecommended, function:askHookFields, function:bashBoundaryViolation, function:realPath, function:parseSensorFeedback, function:formatSensorFeedback, function:activeTodo
+
+import { describe, expect, test } from "bun:test";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import aidlcHarnessAdapter, {
+  bashBoundaryViolation,
+  claudeCalls,
+  execEngineViolation,
+  realPath,
+  type CoreResult,
+} from "../../harness/harness/host/adapter.ts";
+
+type Handler = (event: Record<string, unknown>, ctx: Record<string, unknown>) => unknown;
+type Call = { hook: string; input: Record<string, unknown> };
+
+const OK: CoreResult = { stdout: "", stderr: "", code: 0 };
+
+function load(responses: Record<string, (input: Record<string, unknown>) => CoreResult> = {}) {
+  const calls: Call[] = [];
+  const handlers = new Map<string, Handler[]>();
+  aidlcHarnessAdapter(
+    { on: (event, handler) => handlers.set(event, [...(handlers.get(event) ?? []), handler as Handler]) },
+    {
+      aidlcEntrypoints: new Set(["tools/aidlc.ts", "tools/aidlc-orchestrate.ts"]),
+      runCore: async (hook, input) => {
+        calls.push({ hook, input });
+        return responses[hook]?.(input) ?? OK;
+      },
+    },
+  );
+  const emit = async (
+    event: string,
+    payload: Record<string, unknown>,
+    kind: "main" | "sub" = "main",
+    sessionFile = "/sessions/p/2026_abc.jsonl",
+  ) => {
+    const ctx = {
+      cwd: "/work/project",
+      agent: kind === "main" ? { kind, id: "main", name: "main" } : { kind, id: "0-Review", name: "aidlc-architecture-reviewer-agent" },
+      sessionManager: { getSessionFile: () => sessionFile, getSessionId: () => "abc" },
+    };
+    let result: unknown;
+    for (const handler of handlers.get(event) ?? []) result = (await handler(payload, ctx)) ?? result;
+    return result;
+  };
+  const hooks = () => calls.map((call) => call.hook);
+  return { emit, calls, hooks };
+}
+
+describe("tool mapping", () => {
+  test("read selectors and internal URLs never reach a guard as file paths", () => {
+    expect(realPath("src/a.ts:50-80")).toBe("src/a.ts");
+    expect(realPath("src/a.ts:raw")).toBe("src/a.ts");
+    expect(realPath("data.json?q=.items")).toBe("data.json");
+    expect(realPath("artifact://12")).toBeNull();
+    expect(claudeCalls("read", { path: "a.md:1-5;b.md" })).toEqual([
+      { toolName: "Read", toolInput: { file_path: "a.md" } },
+      { toolName: "Read", toolInput: { file_path: "b.md" } },
+    ]);
+    expect(claudeCalls("todo", { ops: [] })).toEqual([]);
+  });
+
+  test("the bash boundary admits one direct framework invocation and refuses chains", () => {
+    const shipped = new Set(["tools/aidlc-orchestrate.ts"]);
+    expect(bashBoundaryViolation("aidlc engine orchestrate next", shipped)).toBeNull();
+    expect(bashBoundaryViolation("bun .harness-aidlc/tools/aidlc-orchestrate.ts next", shipped)).toBeNull();
+    expect(bashBoundaryViolation("aidlc engine orchestrate next && rm -rf x", shipped)).not.toBeNull();
+    expect(bashBoundaryViolation("bun .harness-aidlc/tools/aidlc-orchestrate.ts next > out", shipped)).not.toBeNull();
+    expect(bashBoundaryViolation("bun .harness-aidlc/tools/evil.ts", shipped)).not.toBeNull();
+    expect(bashBoundaryViolation("npm test && echo done", shipped)).toBeNull();
+  });
+
+  test("another tool's copy of the framework in the same project is refused, naming this distribution's", () => {
+    const shipped = new Set(["tools/aidlc.ts"]);
+    for (const command of [
+      "bun .claude/tools/aidlc.ts engine orchestrate next",
+      "bun ./.aidlc/tools/aidlc-state.ts approve",
+      "bun .claude/hooks/aidlc-continue-workflow.ts",
+    ]) {
+      expect(bashBoundaryViolation(command, shipped), command).toContain("from .harness-aidlc/tools/");
+    }
+    expect(bashBoundaryViolation("bun .harness-aidlc/tools/aidlc.ts engine orchestrate next", shipped)).toBeNull();
+    expect(bashBoundaryViolation("bun scripts/build.ts", shipped)).toBeNull();
+  });
+});
+
+describe("tool_call", () => {
+  test("a write runs the write guards; an exit 2 blocks the call with the hook's reason", async () => {
