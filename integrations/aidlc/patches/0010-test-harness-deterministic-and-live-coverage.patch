+export interface Line {
+  description: string;
+  /** Price of one unit, in cents. */
+  unitPrice: number;
+  quantity: number;
+}
+
+/** Sum of the line totals, in cents. */
+export function subtotal(lines: Line[]): number {
+  return lines.reduce((sum, line) => sum + line.unitPrice * line.quantity, 0);
+}
+
+/** The subtotal after a percentage discount (0-100), rounded to whole cents. */
+export function total(lines: Line[], discountPercent = 0): number {
+  return Math.round(subtotal(lines) - discountPercent);
+}
