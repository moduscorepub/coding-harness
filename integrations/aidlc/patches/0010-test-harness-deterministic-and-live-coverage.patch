diff --git a/tests/e2e/t-harness-bugfix-parity.serial.test.ts b/tests/e2e/t-harness-bugfix-parity.serial.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a352d64c9adfe6e65b1ddbf8d69301dadad59922
--- /dev/null
+++ b/tests/e2e/t-harness-bugfix-parity.serial.test.ts
@@ -0,0 +1,276 @@
+// covers: scope:bugfix
+//
+// t-harness-bugfix-parity.serial.test.ts — S15 and T4: one scripted bugfix
+// journey, run start to finish under Claude Code (the Claude distribution
+// through the Agent SDK driver) and under Coding Harness (the harness
+// distribution through its RPC driver), on the same fixture: a small Bun
+// library whose discount arithmetic is wrong and whose test suite fails on it.
+//
+// Both hosts get the same prompt and the same answer policy (the first option
+// of every structured question, so every gate is approved). Each journey must
+// complete the workflow and leave the fixture's tests passing (S15). The two
+// runs must then agree on what the method did (T4):
+//   - the stage progress in aidlc-state.md,
+//   - per stage, the events the engine enforces, in first-occurrence order:
+//     stage, phase and workflow transitions, workspace setup, plan approval,
+//     summary confirmation, reviews and gates, none of which a workflow can
+//     pass without. Everything else varies with the host or the model, not
+//     the method: sessions, human turns, artifact writes, subagent completions
+//     and sensor rows (the host and how many writes the model makes); the
+//     conductor's own log of non-gate questions (DECISION_RECORDED,
+//     QUESTION_ANSWERED: a model may skip that logging step on either host);
+//     learnings outcomes (RULE_LEARNED, MEMORY_EMPTY: what the model
+//     proposed); and guard and error traces (GUARD_STOOD_ASIDE, ERROR_LOGGED:
+//     which commands the model chose and retried). Repeat counts, such as
+//     review iterations, are the model's too.
+//   - the set of artifact files in the intent record.
+// Usage numbers and model ids may differ.
+//
+// LIVE GATE: AIDLC_HARNESS_RPC_LIVE=1 with the harness live prerequisites (see
+// t-rpc-harness-live), plus the `claude` CLI and a Claude credential for the
+// Agent SDK. Each journey takes tens of minutes; they run concurrently.
+
+import { afterAll, describe, expect, test } from "bun:test";
+import { spawnSync } from "node:child_process";
+import { cpSync, existsSync, mkdtempSync, readdirSync, readFileSync, realpathSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, relative } from "node:path";
+import { HarnessRpc } from "../harness/harness-rpc.ts";
+import { driveAidlc } from "../harness/sdk-drive.ts";
+
+const REPO_ROOT = join(import.meta.dir, "..", "..");
+const FIXTURE = join(REPO_ROOT, "tests", "fixtures", "bugfix-invoice");
+const LIVE = process.env.AIDLC_HARNESS_RPC_LIVE === "1";
+const BIN = process.env.AIDLC_HARNESS_BIN ?? Bun.which("harness") ?? "";
+const KEY = process.env.AIDLC_HARNESS_ANTHROPIC_KEY ?? process.env.ANTHROPIC_API_KEY ?? "";
+const HARNESS_MODEL = process.env.AIDLC_HARNESS_MODEL ?? "anthropic/claude-sonnet-5-5";
+const CLAUDE_MODEL = process.env.AIDLC_PARITY_CLAUDE_MODEL ?? "claude-sonnet-5-5";
+const KEEP = process.env.AIDLC_KEEP_TEMP === "1";
+
+const ENABLED =
+  LIVE &&
+  KEY !== "" &&
+  BIN !== "" &&
+  existsSync(BIN) &&
+  Bun.which("claude") !== null &&
+  existsSync(join(REPO_ROOT, "dist", "harness")) &&
+  existsSync(join(REPO_ROOT, "dist", "claude"));
+const live = ENABLED ? test : test.skip;
+
+const REQUEST =
+  "total() in src/invoice.ts subtracts the discount percentage as if it were an amount in cents: " +
+  "total(lines, 10) on a 3000-cent invoice returns 2990 instead of 2700, and `bun run test` fails on " +
+  '"total applies a percentage discount". Fix the discount calculation.';
+const PROMPT = `/aidlc --scope bugfix ${REQUEST}`;
+const CONTINUE = "Continue the AI-DLC workflow.";
+const MAX_TURNS = 8;
+const TURN_TIMEOUT_MS = 90 * 60_000;
+
+const LIFECYCLE_EVENTS = new Set([
+  "WORKFLOW_STARTED",
+  "WORKFLOW_COMPLETED",
+  "PHASE_STARTED",
+  "PHASE_COMPLETED",
+  "PHASE_VERIFIED",
+  "PHASE_SKIPPED",
+  "STAGE_STARTED",
+  "STAGE_AWAITING_APPROVAL",
+  "STAGE_REVISING",
+  "STAGE_COMPLETED",
+  "STAGE_JUMPED",
+  "STAGE_SKIPPED",
+  "WORKSPACE_SCAFFOLDED",
+  "WORKSPACE_SCANNED",
+  "WORKSPACE_INITIALISED",
+  "GATE_APPROVED",
+  "GATE_REJECTED",
+  "SUMMARY_CONFIRMATION_RECORDED",
+  "VERIFICATION_COMMAND_RECORDED",
+  "CONSTRUCTION_POLICY_RECORDED",
+  "CHECKPOINT_VERIFICATION_RECORDED",
+  "PLAN_APPROVAL_RECORDED",
+  "REVIEW_REQUESTED",
+  "REVIEW_COMPLETED",
+  "UNIT_STARTED",
+  "UNIT_COMPLETED",
+]);
+
+const scratch: string[] = [];
+afterAll(() => {
+  if (KEEP) {
+    console.log(`kept: ${scratch.join(" ")}`);
+    return;
+  }
+  for (const dir of scratch.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function tempDir(prefix: string): string {
+  const dir = realpathSync(mkdtempSync(join(tmpdir(), prefix)));
+  scratch.push(dir);
+  return dir;
+}
+
+function git(dir: string, ...args: string[]): void {
+  const result = spawnSync("git", ["-c", "user.name=fixture", "-c", "user.email=fixture@example.invalid", ...args], {
+    cwd: dir,
+    encoding: "utf-8",
+  });
+  if (result.status !== 0) throw new Error(`git ${args.join(" ")}: ${result.stderr}`);
+}
+
+/** The fixture library with one distribution installed, committed as a brownfield repository. */
+function workspace(distribution: "claude" | "harness"): string {
+  const dir = tempDir(`t-parity-${distribution}-`);
+  cpSync(join(REPO_ROOT, "dist", distribution), dir, { recursive: true });
+  // No MCP servers on either host.
+  rmSync(join(dir, ".mcp.json"), { force: true });
+  cpSync(FIXTURE, dir, { recursive: true });
+  git(dir, "init", "-q");
+  git(dir, "add", "-A");
+  git(dir, "commit", "-q", "-m", "invoice library");
+  return dir;
+}
+
+type AuditRow = { timestamp: string; event: string; stage: string | null; order: number };
+
+function auditRows(dir: string): AuditRow[] {
+  const rows: AuditRow[] = [];
+  const walk = (path: string): void => {
+    for (const entry of readdirSync(path, { withFileTypes: true })) {
+      const full = join(path, entry.name);
+      if (entry.isDirectory()) walk(full);
+      else if (full.includes("/audit/") && entry.name.endsWith(".md")) {
+        for (const block of readFileSync(full, "utf-8").split(/\n---\n/)) {
+          const event = /^\*\*Event\*\*:\s*(\S+)/m.exec(block)?.[1];
+          if (!event) continue;
+          rows.push({
+            timestamp: /^\*\*Timestamp\*\*:\s*(\S+)/m.exec(block)?.[1] ?? "",
+            event,
+            stage: /^\*\*Stage\*\*:\s*(\S+)/m.exec(block)?.[1] ?? null,
+            order: rows.length,
+          });
+        }
+      }
+    }
+  };
+  const spaces = join(dir, "aidlc", "spaces");
+  if (existsSync(spaces)) walk(spaces);
+  return rows.sort((a, b) => a.timestamp.localeCompare(b.timestamp) || a.order - b.order);
+}
+
+function completed(dir: string): boolean {
+  return auditRows(dir).some((row) => row.event === "WORKFLOW_COMPLETED");
+}
+
+/** Per stage, the workflow-owned events in first-occurrence order. */
+function stageEvents(rows: AuditRow[]): Record<string, string[]> {
+  const out: Record<string, string[]> = {};
+  let stage = "(before any stage)";
+  for (const row of rows) {
+    if (row.event === "STAGE_STARTED" && row.stage) stage = row.stage;
+    if (!LIFECYCLE_EVENTS.has(row.event)) continue;
+    const key = row.stage ?? stage;
+    out[key] ??= [];
+    if (!out[key].includes(row.event)) out[key].push(row.event);
+  }
+  return out;
+}
+
+/** The record's `- [x] stage — EXECUTE` progress lines. */
+function stageProgress(dir: string): string[] {
+  const state = recordFiles(dir).find((file) => file.endsWith("aidlc-state.md"));
+  if (!state) return [];
+  return readFileSync(join(recordDir(dir), state), "utf-8")
+    .split("\n")
+    .filter((line) => /^- \[.\] [a-z0-9-]+ — /.test(line));
+}
+
+function recordDir(dir: string): string {
+  const intents = join(dir, "aidlc", "spaces", "default", "intents");
+  const active = readFileSync(join(intents, "active-intent"), "utf-8").trim();
+  return join(intents, active);
+}
+
+/** Artifact files of the intent record, engine bookkeeping and audit shards excluded. */
+function recordFiles(dir: string): string[] {
+  const root = recordDir(dir);
+  const out: string[] = [];
+  const walk = (path: string): void => {
+    for (const entry of readdirSync(path, { withFileTypes: true })) {
+      const full = join(path, entry.name);
+      if (entry.isDirectory()) {
+        if (entry.name !== ".aidlc-engine" && entry.name !== "audit") walk(full);
+      } else out.push(relative(root, full));
+    }
+  };
+  walk(root);
+  return out.sort();
+}
+
+async function harnessJourney(dir: string): Promise<void> {
+  const agentDir = tempDir("t-parity-harness-agent-");
+  const rpc = new HarnessRpc({
+    bin: BIN,
+    cwd: dir,
+    args: ["--approval-mode", "yolo", "--model", HARNESS_MODEL],
+    env: { ANTHROPIC_API_KEY: KEY, PI_CODING_AGENT_DIR: agentDir },
+  });
+  await rpc.start();
+  try {
+    await rpc.prompt(PROMPT, { timeoutMs: TURN_TIMEOUT_MS });
+    for (let turn = 1; turn < MAX_TURNS && !completed(dir); turn++) {
+      await rpc.prompt(CONTINUE, { timeoutMs: TURN_TIMEOUT_MS });
+    }
+  } finally {
+    await rpc.close();
+  }
+}
+
+async function claudeJourney(dir: string): Promise<void> {
+  const configDir = tempDir("t-parity-claude-config-");
+  const options = {
+    projectDir: dir,
+    model: CLAUDE_MODEL,
+    persistSession: true,
+    env: { CLAUDE_CONFIG_DIR: configDir },
+    timeoutMs: TURN_TIMEOUT_MS,
+  };
+  let run = await driveAidlc(PROMPT, options);
+  for (let turn = 1; turn < MAX_TURNS && !completed(dir); turn++) {
+    const session = run.resultEvent?.raw.session_id;
+    if (typeof session !== "string") throw new Error(`Claude turn ${turn} ended without a session id`);
+    run = await driveAidlc(CONTINUE, { ...options, resume: session });
+  }
+}
+
+function fixtureTests(dir: string): { status: number | null; output: string } {
+  const result = spawnSync("bun", ["run", "test"], { cwd: dir, encoding: "utf-8" });
+  return { status: result.status, output: `${result.stdout}${result.stderr}` };
+}
+
+describe("t-harness-bugfix-parity", () => {
+  live(
+    "S15/T4: a scripted bugfix journey completes on both hosts, fixes the bug, and the method's record matches",
+    async () => {
+      const claude = workspace("claude");
+      const harness = workspace("harness");
+      expect(fixtureTests(claude).status, "the fixture starts with a failing test").not.toBe(0);
+
+      await Promise.all([claudeJourney(claude), harnessJourney(harness)]);
+
+      for (const [host, dir] of [
+        ["claude", claude],
+        ["harness", harness],
+      ] as const) {
+        expect(completed(dir), `${host}: workflow completed`).toBe(true);
+        const tests = fixtureTests(dir);
+        expect(tests.status, `${host}: ${tests.output}`).toBe(0);
+      }
+
+      expect(stageProgress(harness)).toEqual(stageProgress(claude));
+      expect(stageEvents(auditRows(harness))).toEqual(stageEvents(auditRows(claude)));
+      expect(recordFiles(harness)).toEqual(recordFiles(claude));
+    },
+    4 * 60 * 60_000,
+  );
+});
