diff --git a/tests/harness/harness-rpc.ts b/tests/harness/harness-rpc.ts
new file mode 100644
index 0000000000000000000000000000000000000000..751f892f62c8daa62907b2f16f87ae46ab6db563
--- /dev/null
+++ b/tests/harness/harness-rpc.ts
@@ -0,0 +1,265 @@
+// tests/harness/harness-rpc.ts — a minimal Coding Harness RPC client for live
+// AI-DLC journeys. It starts `harness --mode rpc-ui --no-ui` in a project,
+// negotiates protocol v2 (reassembling `rpc_chunk` frames), enables the `ask`
+// dialog, and answers every `ask` request through a caller-supplied policy, so
+// a journey's human decisions are scripted. Extensions stay headless; tool UI
+// (the `ask` tool) stays on.
+
+import { type Subprocess, spawn } from "bun";
+
+export type AskQuestion = {
+  id: string;
+  question: string;
+  header?: string;
+  options: Array<{ label: string; description?: string }>;
+  multi?: boolean;
+  recommended?: number;
+};
+export type AskAnswer = { id: string; selectedOptions: string[]; customInput?: string };
+export type AskPolicy = (questions: AskQuestion[]) => AskAnswer[];
+
+export type RpcFrame = Record<string, unknown> & { type: string };
+
+export type HarnessRpcOptions = {
+  bin: string;
+  cwd: string;
+  args?: string[];
+  env?: Record<string, string | undefined>;
+  ask?: AskPolicy;
+  /** Called for every frame (after reassembly), for logging. */
+  onFrame?: (frame: RpcFrame) => void;
+};
+
+export type PromptOutcome = {
+  status: string;
+  frames: RpcFrame[];
+  asks: Array<{ questions: AskQuestion[]; answers: AskAnswer[] }>;
+  toolCalls: Array<{ toolName: string; args: unknown; isError?: boolean; result?: unknown }>;
+};
+
+/** Answer each question with the first option whose label matches, else the first option. */
+export function answerBy(rules: Array<{ when: RegExp; pick: RegExp | string }>): AskPolicy {
+  return questions =>
+    questions.map(question => {
+      const rule = rules.find(candidate => candidate.when.test(`${question.header ?? ""} ${question.question}`));
+      if (rule && typeof rule.pick === "string") return { id: question.id, selectedOptions: [], customInput: rule.pick };
+      const option =
+        (rule && question.options.find(candidate => (rule.pick as RegExp).test(candidate.label))) ?? question.options[0];
+      return { id: question.id, selectedOptions: option ? [option.label] : [] };
+    });
+}
+
+export class HarnessRpc {
+  #proc: Subprocess<"pipe", "pipe", "pipe">;
+  #options: HarnessRpcOptions;
+  #buffer = "";
+  #chunks: { id: string; parts: string[]; count: number } | null = null;
+  #waiters = new Map<string, (frame: RpcFrame) => void>();
+  #listeners = new Set<(frame: RpcFrame) => void>();
+  #nextId = 1;
+  /** The answers sent for each `ask` request, by request id. */
+  #answered = new Map<string, AskAnswer[]>();
+  #ready: Promise<void>;
+  stderr = "";
+
+  constructor(options: HarnessRpcOptions) {
+    this.#options = options;
+    // A journey runs the harness, not Claude Code: Claude Code's session variables
+    // (its OAuth token among them) would be picked up as Anthropic credentials.
+    const env: Record<string, string> = {};
+    for (const [key, value] of Object.entries(process.env)) {
+      if (value !== undefined && !/^CLAUDE_?CODE/.test(key)) env[key] = value;
+    }
+    for (const [key, value] of Object.entries(options.env ?? {})) {
+      if (value === undefined) delete env[key];
+      else env[key] = value;
+    }
+    const proc = spawn([options.bin, "--mode", "rpc-ui", "--no-ui", ...(options.args ?? [])], {
+      cwd: options.cwd,
+      stdin: "pipe",
+      stdout: "pipe",
+      stderr: "pipe",
+      env,
+    });
+    this.#proc = proc;
+    let markReady: () => void = () => {};
+    this.#ready = new Promise<void>(resolve => {
+      markReady = resolve;
+    });
+    const readyListener = (frame: RpcFrame) => {
+      if (frame.type === "ready") {
+        this.#listeners.delete(readyListener);
+        markReady();
+      }
+    };
+    this.#listeners.add(readyListener);
+    void this.#pump();
+    void (async () => {
+      for await (const chunk of proc.stderr) this.stderr += new TextDecoder().decode(chunk);
+    })();
+  }
+
+  async #pump(): Promise<void> {
+    const decoder = new TextDecoder();
+    for await (const chunk of this.#proc.stdout) {
+      this.#buffer += decoder.decode(chunk, { stream: true });
+      let newline = this.#buffer.indexOf("\n");
+      while (newline >= 0) {
+        const line = this.#buffer.slice(0, newline).trim();
+        this.#buffer = this.#buffer.slice(newline + 1);
+        if (line) this.#line(line);
+        newline = this.#buffer.indexOf("\n");
+      }
+    }
+  }
+
+  #line(line: string): void {
+    let frame: RpcFrame;
+    try {
+      frame = JSON.parse(line) as RpcFrame;
+    } catch {
+      return;
+    }
+    if (frame.type === "rpc_chunk") {
+      const id = String(frame.chunkId);
+      if (!this.#chunks || this.#chunks.id !== id) this.#chunks = { id, parts: [], count: Number(frame.count) };
+      this.#chunks.parts[Number(frame.index)] = String(frame.data);
+      if (this.#chunks.parts.filter(part => part !== undefined).length === this.#chunks.count) {
+        const bytes = Buffer.concat(this.#chunks.parts.map(part => Buffer.from(part, "base64")));
+        this.#chunks = null;
+        this.#line(bytes.toString("utf-8"));
+      }
+      return;
+    }
+    this.#options.onFrame?.(frame);
+    if (frame.type === "extension_ui_request") this.#answerUi(frame);
+    if (frame.type === "response" && typeof frame.id === "string") this.#waiters.get(frame.id)?.(frame);
+    for (const listener of [...this.#listeners]) listener(frame);
+  }
+
+  #answerUi(frame: RpcFrame): void {
+    const id = String(frame.id);
+    if (frame.method === "ask") {
+      const questions = (frame.questions ?? []) as AskQuestion[];
+      const answers = (this.#options.ask ?? answerBy([]))(questions);
+      this.#answered.set(id, answers);
+      this.#send({ type: "extension_ui_response", id, answers });
+    } else if (frame.method === "confirm") {
+      this.#send({ type: "extension_ui_response", id, confirmed: true });
+    } else if (frame.method === "select") {
+      const options = (frame.options ?? []) as string[];
+      this.#send({ type: "extension_ui_response", id, value: options[0] ?? "" });
+    } else if (frame.method === "input" || frame.method === "editor") {
+      this.#send({ type: "extension_ui_response", id, cancelled: true });
+    }
+  }
+
+  #send(frame: Record<string, unknown>): void {
+    this.#proc.stdin.write(`${JSON.stringify(frame)}\n`);
+    this.#proc.stdin.flush();
+  }
+
+  /** Send a command and resolve with its response frame. */
+  async command(frame: Record<string, unknown>, timeoutMs = 30_000): Promise<RpcFrame> {
+    await this.#ready;
+    const id = `c${this.#nextId++}`;
+    const response = new Promise<RpcFrame>((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.#waiters.delete(id);
+        reject(new Error(`no response to ${String(frame.type)} within ${timeoutMs}ms\n${this.stderr.slice(-2000)}`));
+      }, timeoutMs);
+      this.#waiters.set(id, response => {
+        clearTimeout(timer);
+        this.#waiters.delete(id);
+        resolve(response);
+      });
+    });
+    this.#send({ ...frame, id });
+    return response;
+  }
+
+  async start(): Promise<void> {
+    await this.#ready;
+    const negotiated = await this.command({ type: "negotiate_protocol", protocolVersion: 2 });
+    if (negotiated.success !== true) throw new Error(`protocol v2 refused: ${JSON.stringify(negotiated)}`);
+    const ask = await this.command({ type: "set_ask_dialog", enabled: true });
+    if (ask.success !== true) throw new Error(`set_ask_dialog refused: ${JSON.stringify(ask)}`);
+  }
+
+  /**
+   * Send a prompt and wait for its prompt_result and the session to settle.
+   * `stopWhen` ends the turn early: once it returns true for a frame, the
+   * driver sends `abort` (a scenario that has seen its evidence need not watch
+   * the conductor carry on with the workflow).
+   */
+  async prompt(
+    message: string,
+    options: { timeoutMs?: number; stopWhen?: (frame: RpcFrame) => boolean } = {},
+  ): Promise<PromptOutcome> {
+    const timeoutMs = options.timeoutMs ?? 15 * 60_000;
+    let aborted = false;
+    const frames: RpcFrame[] = [];
+    const asks: PromptOutcome["asks"] = [];
+    const toolCalls: PromptOutcome["toolCalls"] = [];
+    const pendingTools = new Map<string, PromptOutcome["toolCalls"][number]>();
+    let promptId = "";
+    let status: string | null = null;
+    let settled = false;
+    let resolveDone: () => void = () => {};
+    const done = new Promise<void>(resolve => {
+      resolveDone = resolve;
+    });
+    const listener = (frame: RpcFrame) => {
+      frames.push(frame);
+      if (frame.type === "extension_ui_request" && frame.method === "ask") {
+        const questions = (frame.questions ?? []) as AskQuestion[];
+        asks.push({ questions, answers: this.#answered.get(String(frame.id)) ?? [] });
+      }
+      if (frame.type === "tool_execution_start") {
+        const call = { toolName: String(frame.toolName), args: frame.args };
+        pendingTools.set(String(frame.toolCallId), call);
+        toolCalls.push(call);
+      }
+      if (frame.type === "tool_execution_end") {
+        const call = pendingTools.get(String(frame.toolCallId));
+        if (call) {
+          call.isError = frame.isError === true;
+          call.result = frame.result;
+        }
+      }
+      if (frame.type === "prompt_result" && frame.id === promptId) {
+        status = String(frame.status);
+        settled ||= frame.sessionSettled === true;
+      }
+      if (frame.type === "session_settled") settled = true;
+      if (!aborted && options.stopWhen?.(frame)) {
+        aborted = true;
+        this.#send({ type: "abort", id: `abort-${this.#nextId++}` });
+      }
+      if (status !== null && settled) resolveDone();
+    };
+    this.#listeners.add(listener);
+    try {
+      const response = await this.command({ type: "prompt", message });
+      promptId = String(response.id);
+      if (response.success !== true) throw new Error(`prompt refused: ${JSON.stringify(response)}`);
+      const data = (response.data ?? {}) as { agentInvoked?: boolean };
+      if (data.agentInvoked === false) return { status: "local", frames, asks, toolCalls };
+      const timer = setTimeout(() => resolveDone(), timeoutMs);
+      await done;
+      clearTimeout(timer);
+      if (status === null) throw new Error(`prompt did not finish within ${timeoutMs}ms`);
+      return { status, frames, asks, toolCalls };
+    } finally {
+      this.#listeners.delete(listener);
+    }
+  }
+
+  async close(): Promise<number> {
+    this.#proc.stdin.end();
+    const timer = setTimeout(() => this.#proc.kill(), 60_000);
+    const code = await this.#proc.exited;
+    clearTimeout(timer);
+    return code;
+  }
+}
