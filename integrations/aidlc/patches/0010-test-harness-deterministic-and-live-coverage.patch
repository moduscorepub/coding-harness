+++ b/tests/unit/t-harness-config-doctor.test.ts
@@ -0,0 +1,159 @@
+// t-harness-config-doctor: configuration and diagnosis of a Coding Harness
+// project (a copy of the shipped dist/harness tree), through the engine's own
+// commands:
+//   - the doctor fails, with its fix, when the bootstrap extension is missing or
+//     gitignored (the harness would silently load no AI-DLC at all);
+//   - a model-policy preset rewrites the task agents' thinkingLevel per tier;
+//   - a space switch re-points the method include and every persona's method
+//     paths, and the adapter's next system-prompt injection carries the new
+//     space's memory;
+//   - the Claude and harness distributions configured into one project each
+//     pass their own doctor, which names the distribution it checks.
+//
+// covers: function:repointHarnessIncludes, function:repointHarnessIncludesJson, function:buildConstitution
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { spawnSync } from "node:child_process";
+import { appendFileSync, cpSync, mkdtempSync, readFileSync, readdirSync, realpathSync, renameSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const REPO_ROOT = join(import.meta.dir, "..", "..");
+const DIST = join(REPO_ROOT, "dist", "harness");
+const ENGINE = ".harness-aidlc";
+const scratch: string[] = [];
+afterEach(() => {
+  for (const dir of scratch.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function project(): string {
+  const dir = realpathSync(mkdtempSync(join(tmpdir(), "t-harness-config-")));
+  scratch.push(dir);
+  cpSync(DIST, dir, { recursive: true });
+  spawnSync("git", ["init", "-q"], { cwd: dir });
+  return dir;
+}
+
+function aidlcIn(engine: string, dir: string, ...args: string[]): { code: number; out: string } {
+  const env = { ...process.env };
+  delete env.AIDLC_PROJECT_DIR;
+  delete env.CLAUDE_PROJECT_DIR;
+  const result = spawnSync(process.execPath, [join(engine, "tools", "aidlc.ts"), ...args], {
+    cwd: dir,
+    encoding: "utf-8",
+    env,
+    timeout: 120_000,
+  });
+  return { code: result.status ?? -1, out: `${result.stdout}${result.stderr}` };
+}
+
+function aidlc(dir: string, ...args: string[]): { code: number; out: string } {
+  return aidlcIn(ENGINE, dir, ...args);
+}
+
+function frontmatterValue(text: string, key: string): string | null {
+  const block = /^---\n([\s\S]*?)\n---\n/.exec(text)?.[1] ?? "";
+  return new RegExp(`^${key}:\\s*(.*)$`, "m").exec(block)?.[1] ?? null;
+}
+
+describe("doctor", () => {
+  test("a missing bootstrap extension fails with the restore fix", () => {
+    const dir = project();
+    expect(aidlc(dir, "doctor", "--project-dir", dir).code).toBe(0);
+    renameSync(join(dir, ".harness", "extensions", "aidlc.ts"), join(dir, "bootstrap.bak"));
+    const broken = aidlc(dir, "doctor", "--project-dir", dir);
+    expect(broken.code).toBe(1);
+    expect(broken.out).toContain("fail  .harness/extensions/aidlc.ts present (bootstrap the harness auto-loads)");
+    expect(broken.out).toContain(".harness/extensions/aidlc.ts");
+  });
+
+  test("a gitignored bootstrap fails: the harness would skip it", () => {
+    const dir = project();
+    appendFileSync(join(dir, ".gitignore"), ".harness/\n");
+    const result = aidlc(dir, "doctor", "--project-dir", dir);
+    expect(result.code).toBe(1);
+    expect(result.out).toContain("fail  .harness/extensions/aidlc.ts is not gitignored");
+  });
+});
+
+describe("coexistence", () => {
+  test("Claude and harness distributions in one project each pass the doctor that names them", () => {
+    const dir = realpathSync(mkdtempSync(join(tmpdir(), "t-harness-coexist-")));
+    scratch.push(dir);
+    spawnSync("git", ["init", "-q"], { cwd: dir });
+    for (const harness of ["claude", "harness"]) {
+      const configured = spawnSync(
+        process.execPath,
+        [
+          join(REPO_ROOT, "core", "tools", "aidlc-init.ts"),
+          "config",
+          "--project-dir",
+          dir,
+          "--from",
+          join(REPO_ROOT, "dist-release", harness),
+          "--harness",
+          harness,
+          "--mcp",
+          "none",
+        ],
+        { cwd: dir, encoding: "utf-8", timeout: 120_000 },
+      );
+      expect(configured.status, `${configured.stdout}${configured.stderr}`).toBe(0);
+    }
+    for (const [engine, heading] of [
+      [".claude", "Project (.claude, Claude Code)"],
+      [ENGINE, "Project (.harness-aidlc, Coding Harness)"],
+    ]) {
+      const doctor = aidlcIn(engine, dir, "doctor", "--project-dir", dir);
+      expect(doctor.code, doctor.out).toBe(0);
+      expect(doctor.out).toContain(heading);
+    }
+  });
+});
+
+describe("model policy", () => {
+  test("a preset sets thinkingLevel per tier on the task agents and never pins a model", () => {
+    const dir = project();
+    const result = aidlc(dir, "config", "models", "--preset", "minimal", "--project", "--yes");
+    expect(result.code, result.out).toBe(0);
+    const agents = join(dir, ENGINE, "host", "agents");
+    const levels = new Map<string, string | null>();
+    for (const name of readdirSync(agents)) {
+      const text = readFileSync(join(agents, name), "utf-8");
+      expect(frontmatterValue(text, "model"), name).toBeNull();
+      levels.set(name, frontmatterValue(text, "thinkingLevel"));
+    }
+    // minimal: medium for deciding and reviewing, low for writing up.
+    expect(levels.get("aidlc-delivery-agent.md")).toBe("low");
+    expect(levels.get("aidlc-architecture-reviewer-agent.md")).toBe("medium");
+    expect(levels.get("aidlc-developer-agent.md")).toBe("medium");
+    // A non-delegating agent keeps its spawn ban through the rewrite.
+    expect(frontmatterValue(readFileSync(join(agents, "aidlc-developer-agent.md"), "utf-8"), "spawns")).toBe("[]");
+  });
+});
+
+describe("space switch", () => {
+  test("the method include and persona paths follow the active space into the system prompt", async () => {
+    const dir = project();
+    expect(aidlc(dir, "engine", "space", "create", "team-b").code).toBe(0);
+    appendFileSync(join(dir, "aidlc", "spaces", "team-b", "memory", "org.md"), "\nTeam B marker: ORCHID-7.\n");
+    const switched = aidlc(dir, "engine", "space", "switch", "team-b");
+    expect(switched.code, switched.out).toBe(0);
+
+    const includes = JSON.parse(readFileSync(join(dir, ENGINE, "host", "includes.json"), "utf-8")) as { memory: string };
+    expect(includes.memory).toBe("aidlc/spaces/team-b/memory");
+    for (const surface of [join(ENGINE, "host", "agents"), join(ENGINE, "agents")]) {
+      for (const name of readdirSync(join(dir, surface))) {
+        const text = readFileSync(join(dir, surface, name), "utf-8");
+        expect(text, `${surface}/${name}`).not.toContain("aidlc/spaces/default/memory/");
+      }
+    }
+
+    const { buildConstitution } = (await import(join(dir, ENGINE, "host", "adapter.ts"))) as {
+      buildConstitution: (cwd: string) => string | null;
+    };
+    const injected = buildConstitution(dir) ?? "";
+    expect(injected).toContain("## aidlc/spaces/team-b/memory/org.md");
+    expect(injected).toContain("Team B marker: ORCHID-7.");
+  });
+});
