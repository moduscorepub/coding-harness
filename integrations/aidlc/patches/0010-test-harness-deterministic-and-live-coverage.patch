+// covers: file:skills/aidlc/SKILL.md, hook:aidlc-session-start, hook:aidlc-session-end, hook:aidlc-plan-approval-guard, hook:aidlc-state-transition-guard, hook:aidlc-run-sensors
+//
+// t-rpc-harness-live.serial.test.ts — drive the shipped dist/harness tree
+// through Coding Harness's RPC mode (`harness --mode rpc-ui --no-ui`) with real
+// model turns and scripted `ask` answers, and assert on the project's on-disk
+// state and the tool results the model saw:
+//   - S1/S3/S10/S11: `/aidlc` starts a bugfix through structured questions that
+//     open with no option pre-selected; a stage dispatch carries its rule
+//     bundle; the session is recorded start to end and its usage reaches the
+//     ledger.
+//   - S2: an edit before the code-generation plan is approved is refused.
+//   - S6: a write that fires a sensor returns the verdict to the model.
+//   - S7: a direct state-transition verb through bash is refused.
+//   - S8: ending the turn mid-workflow is answered with a continuation.
+//   - S9: compaction leaves the recovery breadcrumb.
+//   - S12: an agent's configured thinking level reaches its spawned session.
+//   - S14: a space switch changes the method memory the next turn sees.
+//
+// LIVE GATE: requires AIDLC_HARNESS_RPC_LIVE=1, Coding Harness >= 1.1.0
+// (AIDLC_HARNESS_BIN or `harness` on PATH) and an Anthropic credential in
+// AIDLC_HARNESS_ANTHROPIC_KEY or ANTHROPIC_API_KEY. The model defaults to
+// anthropic/claude-sonnet-5-5 (AIDLC_HARNESS_MODEL). Skips cleanly otherwise.
+
+import { afterAll, describe, expect, test } from "bun:test";
+import { spawnSync } from "node:child_process";
+import {
+  cpSync,
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readdirSync,
+  readFileSync,
+  realpathSync,
+  rmSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { stateDigest, writeActiveDirectiveMarker } from "../../core/tools/aidlc-lib.ts";
+import {
+  DEFAULT_RECORD_DIR,
+  DEFAULT_SPACE,
+  intentsDirOf,
+  seededAuditDir,
+  seededRecordDir,
+  seededStateFile,
+} from "../harness/fixtures.ts";
+import { type AskPolicy, HarnessRpc, type PromptOutcome } from "../harness/harness-rpc.ts";
+
+const REPO_ROOT = join(import.meta.dir, "..", "..");
+const DIST = join(REPO_ROOT, "dist", "harness");
+const LIVE = process.env.AIDLC_HARNESS_RPC_LIVE === "1";
+const BIN = process.env.AIDLC_HARNESS_BIN ?? Bun.which("harness") ?? "";
+const KEY = process.env.AIDLC_HARNESS_ANTHROPIC_KEY ?? process.env.ANTHROPIC_API_KEY ?? "";
+const MODEL = process.env.AIDLC_HARNESS_MODEL ?? "anthropic/claude-sonnet-5-5";
+
+function binaryReady(): boolean {
+  if (!BIN || !existsSync(BIN)) return false;
+  const version = spawnSync(BIN, ["--version"], { encoding: "utf-8" }).stdout.trim();
+  const match = /(\d+)\.(\d+)\.(\d+)/.exec(version);
+  return match !== null && (Number(match[1]) > 1 || (Number(match[1]) === 1 && Number(match[2]) >= 1));
+}
+
+const ENABLED = LIVE && KEY !== "" && binaryReady() && existsSync(DIST);
+const live = ENABLED ? test : test.skip;
+const scratch: string[] = [];
+afterAll(() => {
+  for (const dir of scratch.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function project(): string {
+  const dir = realpathSync(mkdtempSync(join(tmpdir(), "t-rpc-harness-")));
+  scratch.push(dir);
+  cpSync(DIST, dir, { recursive: true });
+  spawnSync("git", ["init", "-q"], { cwd: dir });
+  return dir;
+}
+
+/** A project with the brownfield-feature workflow active, at `stage`. */
+function seededProject(stage: string): string {
+  const dir = project();
+  const intentsDir = intentsDirOf(dir, DEFAULT_SPACE);
+  mkdirSync(seededRecordDir(dir), { recursive: true });
+  writeFileSync(join(intentsDir, "active-intent"), `${DEFAULT_RECORD_DIR}\n`);
+  writeFileSync(
+    join(intentsDir, "intents.json"),
+    `${JSON.stringify([{ uuid: "00000000-0000-7000-8000-000000000001", slug: DEFAULT_RECORD_DIR.replace(/-[0-9a-f]+$/, ""), status: "in-flight" }], null, 2)}\n`,
+  );
+  const state = readFileSync(join(REPO_ROOT, "tests", "fixtures", "state-brownfield-feature.md"), "utf-8").replace(
+    /(- \*\*Current Stage\*\*:\s*)[^\n]+/,
+    `$1${stage}`,
+  );
+  writeFileSync(seededStateFile(dir), state);
+  mkdirSync(seededAuditDir(dir), { recursive: true });
+  return dir;
+}
+
+function session(dir: string, ask?: AskPolicy): HarnessRpc {
+  const agentDir = mkdtempSync(join(tmpdir(), "t-rpc-harness-agent-"));
+  scratch.push(agentDir);
+  return new HarnessRpc({
+    bin: BIN,
+    cwd: dir,
+    args: ["--approval-mode", "yolo", "--model", MODEL],
+    env: { ANTHROPIC_API_KEY: KEY, PI_CODING_AGENT_DIR: agentDir },
+    ask,
+  });
+}
+
+function audit(dir: string): string {
+  const auditDir = seededAuditDir(dir);
+  if (!existsSync(auditDir)) return "";
+  return readdirSync(auditDir)
+    .filter((name) => name.endsWith(".md"))
+    .map((name) => readFileSync(join(auditDir, name), "utf-8"))
+    .join("\n");
+}
+
+function allAudits(dir: string): string {
+  const spaces = join(dir, "aidlc", "spaces");
+  const out: string[] = [];
+  const walk = (path: string): void => {
+    for (const entry of readdirSync(path, { withFileTypes: true })) {
+      const full = join(path, entry.name);
+      if (entry.isDirectory()) walk(full);
+      else if (full.includes("/audit/") && entry.name.endsWith(".md")) out.push(readFileSync(full, "utf-8"));
+    }
+  };
+  if (existsSync(spaces)) walk(spaces);
+  return out.join("\n");
+}
+
+function resultText(call: PromptOutcome["toolCalls"][number]): string {
+  const result = call.result as { content?: Array<{ type?: string; text?: string }> } | undefined;
+  return (result?.content ?? []).map((block) => block.text ?? "").join("\n");
+}
+
+describe("t-rpc-harness-live", () => {
+  live(
+    "S1/S10/S11: /aidlc runs a bugfix through structured questions and subagents; the session is recorded and its usage folded",
+    async () => {
+      const dir = project();
+      mkdirSync(join(dir, "src"), { recursive: true });
+      writeFileSync(join(dir, "src", "math.js"), "export function add(a, b) {\n  return Math.abs(a) + b;\n}\n");
+      writeFileSync(join(dir, "package.json"), `${JSON.stringify({ name: "fixture", type: "module" }, null, 2)}\n`);
+      // Answer every structured question with its first option. Questions before
+      // the plan gate precede the intent, so no intent audit can record them;
+      // run until the first question asked inside the workflow is answered
+      // (its tool result lands after record-human-turn ran), then end the turn.
+      const rpc = session(dir, (questions) =>
+        questions.map((question) => ({
+          id: question.id,
+          selectedOptions: question.options[0] ? [question.options[0].label] : [],
+        })),
+      );
+      await rpc.start();
+      const registry = join(intentsDirOf(dir, DEFAULT_SPACE), "intents.json");
+      const hasIntent = () => existsSync(registry) && readFileSync(registry, "utf-8").includes('"scope"');
+      let workflowAsked = false;
+      // A task dispatched before the intent exists (the composer) has no intent
+      // audit to record into, exactly as on Claude Code.
+      let workflowTask = false;
+      let anyTask = false;
+      const outcome = await rpc.prompt(
+        "/aidlc bugfix: add() in src/math.js returns the wrong sum when the first argument is negative",
+        {
+          stopWhen: (frame) => {
+            if (frame.type === "tool_execution_start" && frame.toolName === "task") {
+              anyTask = true;
+              if (hasIntent()) workflowTask = true;
+            }
+            if (frame.type === "extension_ui_request" && frame.method === "ask" && hasIntent()) workflowAsked = true;
+            return workflowAsked && frame.type === "tool_execution_end" && frame.toolName === "ask";
+          },
+        },
+      );
+      const state = (await rpc.command({ type: "get_state" })).data as { sessionFile?: string };
+      await rpc.close();
+
+      expect(["completed", "aborted"]).toContain(outcome.status);
+      expect(outcome.asks.length, "the conductor asked through the ask tool").toBeGreaterThan(1);
+      // Every ask records a human decision, so none opens with an option pre-selected.
+      for (const ask of outcome.asks) {
+        for (const question of ask.questions) expect(question, question.id).not.toHaveProperty("recommended");
+      }
+      const registryText = readFileSync(registry, "utf-8");
+      const intents = JSON.parse(registryText) as Array<{ scope?: string }>;
+      // The plan the conductor proposes (stock bugfix or a composed grid) is the
+      // model's call; the journey must reach a created, scoped intent.
+      expect(
+        intents.some((intent) => typeof intent.scope === "string" && intent.scope.length > 0),
+        registryText,
+      ).toBe(true);
+      const rows = allAudits(dir);
+      for (const event of ["WORKFLOW_STARTED", "STAGE_STARTED", "HUMAN_TURN", "SESSION_ENDED"]) {
