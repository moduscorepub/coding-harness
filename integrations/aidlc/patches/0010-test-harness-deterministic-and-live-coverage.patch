+// t-harness-emit: the Coding Harness shell emitted by harness/harness/emit.ts.
+// Persona task agents carry the harness-native projection of their tier (no
+// model pin, thinkingLevel only where the tier sets one, spawns: [] for agents
+// that may not delegate, no turn cap) with every token resolved; the method
+// include list is the Claude include stub's list; the adapter's bash boundary
+// admits exactly the shipped engine entrypoints; and a checked-in orchestrator
+// skill that drifts from its Claude derivation fails the build.
+//
+// covers: function:deriveSkill, function:assertSkillCurrent, function:includeFiles
+
+import { describe, expect, test } from "bun:test";
+import { cpSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { assertSkillCurrent, includeFiles } from "../../harness/harness/emit.ts";
+
+const REPO_ROOT = join(import.meta.dir, "..", "..");
+const TREES = {
+  dist: join(REPO_ROOT, "dist", "harness"),
+  release: join(REPO_ROOT, "dist-release", "harness"),
+};
+const ENGINE = ".harness-aidlc";
+
+function frontmatter(text: string): Record<string, string | undefined> {
+  const block = /^---\n([\s\S]*?)\n---\n/.exec(text)?.[1] ?? "";
+  const fields: Record<string, string | undefined> = {};
+  for (const line of block.split("\n")) {
+    const match = /^([A-Za-z][\w-]*):\s*(.*)$/.exec(line);
+    if (match) fields[match[1]] = match[2];
+  }
+  return fields;
+}
+
+describe("persona task agents", () => {
+  const coreAgents = readdirSync(join(REPO_ROOT, "core", "agents")).filter((name) => name.endsWith(".md")).sort();
+
+  test("every core persona ships as a harness task agent", () => {
+    expect(readdirSync(join(TREES.dist, ENGINE, "host", "agents")).sort()).toEqual(coreAgents);
+  });
+
+  for (const name of coreAgents) {
+    test(`${name}: tier projection, delegation and resolved tokens`, () => {
+      const core = frontmatter(readFileSync(join(REPO_ROOT, "core", "agents", name), "utf-8"));
+      const text = readFileSync(join(TREES.dist, ENGINE, "host", "agents", name), "utf-8");
+      const fields = frontmatter(text);
+      expect(fields.name).toBe(name.replace(/\.md$/, ""));
+      for (const key of ["tier", "model", "maxTurns", "disallowedTools", "thinking"]) {
+        expect(fields[key], `${name} must not carry ${key}`).toBeUndefined();
+      }
