+      }
+      if (workflowTask) {
+        expect(rows).toContain("**Event**: SUBAGENT_COMPLETED");
+        // S3: a stage dispatch carries the active stage's rule bundle into the
+        // subagent's assignment (deliver-stage-rules rewrote the task input).
+        const artifacts = String(state.sessionFile).replace(/\.jsonl$/, "");
+        const transcripts = readdirSync(artifacts, { recursive: true })
+          .map(String)
+          .filter((name) => name.endsWith(".jsonl") && !name.includes("__advisor"));
+        expect(
+          transcripts.some((name) => readFileSync(join(artifacts, name), "utf-8").includes("Active AI-DLC Rule Bundle")),
+          transcripts.join(", "),
+        ).toBe(true);
+      }
+      const ledger = JSON.parse(readFileSync(join(dir, "aidlc", ".aidlc-sessions", "usage-ledger.json"), "utf-8")) as {
+        totals: { tokens: { input: number; output: number } };
+        byAgent: Record<string, unknown>;
+      };
+      expect(ledger.totals.tokens.output).toBeGreaterThan(0);
+      expect(Object.keys(ledger.byAgent)).toContain("main");
+      // Subagent transcripts are folded and attributed by agent type.
+      if (anyTask) expect(Object.keys(ledger.byAgent).filter((agent) => agent !== "main").length).toBeGreaterThan(0);
+    },
+    30 * 60_000,
+  );
+
+  live(
+    "S8: stopping mid-workflow after engaging the engine is answered with a continuation",
+    async () => {
+      const dir = seededProject("requirements-analysis");
+      const rpc = session(dir);
+      await rpc.start();
+      const outcome = await rpc.prompt(
+        "Run exactly `bun .harness-aidlc/tools/aidlc.ts engine orchestrate next` with the bash tool, " +
+          "then end your turn immediately without doing anything else.",
+        { stopWhen: (frame) => JSON.stringify(frame).includes("The AIDLC workflow has a pending step") },
