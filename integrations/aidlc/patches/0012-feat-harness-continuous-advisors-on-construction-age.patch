+// ---------------------------------------------------------------------------
+// Advisor context: the active intent's human-approved artifacts.
+// ---------------------------------------------------------------------------
+
+// Initialization stages auto-proceed; nothing in them was approved by a human.
+const APPROVED_PHASE_DIRS = ["ideation", "inception", "construction", "operation"];
+
+/** The active intent's record directory, or null when no workflow is active. */
+export function activeRecordDir(cwd: string): string | null {
+  try {
+    const spaceFile = join(cwd, "aidlc", "active-space");
+    const space = (existsSync(spaceFile) ? readFileSync(spaceFile, "utf-8").trim() : "") || "default";
+    const intents = join(cwd, "aidlc", "spaces", space, "intents");
+    const name = readFileSync(join(intents, "active-intent"), "utf-8").trim();
+    if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(name)) return null;
+    const record = join(intents, name);
+    return existsSync(join(record, "aidlc-state.md")) ? record : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Artifacts of the stages the human approved, project-relative: no question files, diaries or reviews. */
+export function approvedArtifacts(cwd: string, record: string): string[] {
+  const state = readFileSync(join(record, "aidlc-state.md"), "utf-8");
+  const approved = new Set([...state.matchAll(/^- \[x\] ([a-z0-9-]+) —/gm)].map((match) => match[1]));
+  const out: string[] = [];
+  const collect = (dir: string): void => {
+    for (const entry of readdirSync(dir, { withFileTypes: true })) {
+      const full = join(dir, entry.name);
+      if (entry.isDirectory()) {
+        if (entry.name !== "reviews") collect(full);
+      } else if (entry.name.endsWith(".md") && !entry.name.endsWith("-questions.md") && entry.name !== "memory.md") {
+        out.push(relative(cwd, full));
+      }
+    }
+  };
+  for (const phase of APPROVED_PHASE_DIRS) {
+    const phaseDir = join(record, phase);
+    if (!existsSync(phaseDir)) continue;
+    for (const entry of readdirSync(phaseDir, { withFileTypes: true })) {
+      if (!entry.isDirectory()) continue;
+      if (approved.has(entry.name)) collect(join(phaseDir, entry.name));
+      else if (phase === "construction") {
+        // Per-unit construction stages live under <unit>/<stage>/.
+        for (const stage of approved) {
+          const unitStage = join(phaseDir, entry.name, stage);
+          if (existsSync(unitStage)) collect(unitStage);
+        }
+      }
+    }
+  }
+  return out.sort();
+}
+
+// Approved artifacts inlined into the advisor prompt (by `@` import) up to this
+// many bytes; the rest are listed for the advisor to read when a change touches them.
+const WATCHDOG_INLINE_BYTES = 24 * 1024;
+
+/** Write the advisor context for the active intent (only when it changed); its path, or null without a workflow. */
+export function writeWatchdogContext(cwd: string): string | null {
+  const record = activeRecordDir(cwd);
+  if (!record) return null;
+  const state = readFileSync(join(record, "aidlc-state.md"), "utf-8");
+  const stage = /^- \*\*Current Stage\*\*:\s*(\S+)/m.exec(state)?.[1] ?? "unknown";
+  // Advisor discovery keeps extension files named WATCHDOG.md only.
+  const file = join(record, ".aidlc-engine", "harness", "WATCHDOG.md");
+  const inlined: string[] = [];
+  const listed: string[] = [];
+  let budget = WATCHDOG_INLINE_BYTES;
+  for (const path of approvedArtifacts(cwd, record)) {
+    const size = statSync(join(cwd, path)).size;
+    if (size <= budget) {
+      budget -= size;
+      inlined.push(`### ${path}\n\n@${relative(dirname(file), join(cwd, path))}\n`);
+    } else {
+      listed.push(`- \`${path}\``);
+    }
+  }
+  const text =
+    `# AI-DLC watchdog context\n\nActive intent \`${relative(cwd, record)}\`, current stage \`${stage}\`.\n\n` +
+    (inlined.length + listed.length === 0
+      ? "No stage has been approved yet.\n"
+      : `## Human-approved artifacts\n\n${inlined.join("\n")}` +
+        (listed.length > 0 ? `\nMore approved artifacts; read the ones a change touches:\n\n${listed.join("\n")}\n` : ""));
+  try {
+    if (!existsSync(file) || readFileSync(file, "utf-8") !== text) {
+      mkdirSync(dirname(file), { recursive: true });
+      writeFileSync(file, text);
+    }
+    return file;
+  } catch {
+    return null;
+  }
+}
