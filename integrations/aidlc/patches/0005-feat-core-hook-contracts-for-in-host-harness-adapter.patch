+// ---------------------------------------------------------------------------
+// Coding Harness sessions: `<sessions>/<cwd>/<ts>_<id>.jsonl` opens with a
+// `{"type":"title"}` line and a `{"type":"session","version":N,"cwd":…}`
+// header. Subagent and advisor transcripts live beside it in
+// `<ts>_<id>/<agent id>.jsonl` (`__advisor*.jsonl` for advisors), nested one
+// directory deeper for each further delegation level.
+// ---------------------------------------------------------------------------
+
+/** True when `path` is a Coding Harness session transcript. Reads only the first lines. */
+export function isHarnessSessionTranscript(path: string): boolean {
+  let head: string;
+  try {
+    head = readFileSync(path, "utf-8").slice(0, 8192);
+  } catch {
+    return false;
+  }
+  for (const line of head.split("\n").slice(0, 4)) {
+    const trimmed = line.trim();
+    if (!trimmed) continue;
+    try {
+      const obj = JSON.parse(trimmed) as Record<string, unknown>;
+      if (obj.type === "session" && typeof obj.version === "number" && typeof obj.cwd === "string") return true;
+    } catch {
+      return false;
+    }
+  }
+  return false;
+}
+
+export type HarnessSubagentFile = { path: string; sourceKey: string; agentId: string };
+
+/** Every subagent/advisor transcript below a harness session, depth-first, sorted. */
+export function harnessSubagentFiles(mainPath: string): HarnessSubagentFile[] {
+  const root = mainPath.replace(/\.jsonl$/, "");
+  const files: HarnessSubagentFile[] = [];
+  const walk = (dir: string, prefix: string): void => {
+    let entries: string[];
+    try {
+      entries = readdirSync(dir).sort();
+    } catch {
+      return;
+    }
+    for (const name of entries) {
+      const full = join(dir, name);
+      if (name.endsWith(".jsonl")) {
+        const id = name.replace(/\.jsonl$/, "");
+        files.push({ path: full, sourceKey: `agent-${prefix}${id}`, agentId: `${prefix}${id}` });
+        walk(full.replace(/\.jsonl$/, ""), `${prefix}${id}/`);
+      }
+    }
+  };
+  walk(root, "");
+  return files;
+}
+
+/**
+ * Agent type per subagent id. Advisors are `advisor`; task subagents take the
+ * agent their parent's `task` call named, matched on the task name the harness
+ * puts after the spawn index (`0-Explore` → `Explore`).
+ */
+export function harnessAgentTypes(mainPath: string, files: HarnessSubagentFile[]): Record<string, string> {
+  const agentByTaskName: Record<string, string> = {};
+  const collect = (path: string): void => {
+    let raw: string;
+    try {
+      raw = readFileSync(path, "utf-8");
+    } catch {
+      return;
+    }
+    for (const line of raw.split("\n")) {
+      if (!line.includes("\"toolCall\"")) continue;
+      let obj: Record<string, unknown>;
+      try {
+        obj = JSON.parse(line) as Record<string, unknown>;
+      } catch {
+        continue;
+      }
+      const content = (obj.message as Record<string, unknown> | undefined)?.content;
+      if (!Array.isArray(content)) continue;
+      for (const block of content) {
+        const b = block as Record<string, unknown>;
+        if (b?.type !== "toolCall" || b.name !== "task") continue;
+        const args = (b.arguments ?? {}) as Record<string, unknown>;
+        const items = Array.isArray(args.tasks) ? args.tasks : [args];
+        for (const item of items) {
+          const record = item as Record<string, unknown>;
+          if (typeof record?.name === "string" && typeof record.agent === "string") {
+            agentByTaskName[record.name] = record.agent;
+          }
+        }
+      }
+    }
+  };
+  collect(mainPath);
+  for (const file of files) collect(file.path);
+  const types: Record<string, string> = {};
+  for (const file of files) {
+    const leaf = file.agentId.split("/").pop() ?? file.agentId;
+    if (leaf.startsWith("__advisor")) {
+      types[file.agentId] = "advisor";
+      continue;
+    }
+    const taskName = leaf.replace(/^\d+-/, "");
+    const agent = agentByTaskName[taskName] ?? agentByTaskName[leaf];
+    if (agent) types[file.agentId] = agent;
+  }
+  return types;
+}
