+// Coding Harness usage: `cacheWrite` is the total cache creation; the 1h share
+// arrives as `cttl.ephemeral1h` when the provider reports it.
+function countsFromHarnessUsage(usage: Record<string, unknown>): TokenCounts {
+  const num = (v: unknown): number => (typeof v === "number" && Number.isFinite(v) ? v : 0);
+  const cttl = (usage.cttl ?? {}) as Record<string, unknown>;
+  const write = num(usage.cacheWrite);
+  const oneHour = Math.min(num(cttl.ephemeral1h), write);
+  return {
+    input: num(usage.input),
+    output: num(usage.output),
+    cacheCreate5m: write - oneHour,
+    cacheCreate1h: oneHour,
+    cacheRead: num(usage.cacheRead),
+  };
+}
+
+// The harness prices every call it makes, including models outside the AI-DLC
+// rate table; use that figure when the table has no entry for the model.
+function harnessReportedCost(usage: Record<string, unknown>): number | null {
+  const cost = usage.cost as Record<string, unknown> | undefined;
+  return typeof cost?.total === "number" && Number.isFinite(cost.total) ? cost.total : null;
+}
