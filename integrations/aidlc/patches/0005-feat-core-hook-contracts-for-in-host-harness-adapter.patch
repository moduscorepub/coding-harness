+/** The dispatcher's FireVerdict lines (`{fire_id, sensor_id, …}`) in its stdout. */
+export function fireVerdicts(stdout: string): Record<string, unknown>[] {
+  const verdicts: Record<string, unknown>[] = [];
+  for (const line of stdout.split("\n")) {
+    const trimmed = line.trim();
+    if (!trimmed.startsWith("{")) continue;
+    try {
+      const parsed = JSON.parse(trimmed) as unknown;
+      if (
+        parsed && typeof parsed === "object" && !Array.isArray(parsed) &&
+        typeof (parsed as Record<string, unknown>).fire_id === "string" &&
+        typeof (parsed as Record<string, unknown>).sensor_id === "string"
+      ) {
+        verdicts.push(parsed as Record<string, unknown>);
+      }
+    } catch {
+      // Not a verdict line.
+    }
+  }
+  return verdicts;
+}
