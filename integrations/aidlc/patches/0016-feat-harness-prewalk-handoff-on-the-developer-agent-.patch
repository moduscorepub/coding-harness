 //     interrupted before it reaches disk.
 //   - S20: /aidlc-checkers records the project's lint and test commands, and a
 //     write that breaks the lint fails project-checks with the finding.
+//   - S21: a dispatched developer hands off to the smol model at its first
+//     write after recording its todos (prewalk).
 //
 // LIVE GATE: requires AIDLC_HARNESS_RPC_LIVE=1, Coding Harness >= 1.1.0
 // (AIDLC_HARNESS_BIN or `harness` on PATH) and an Anthropic credential in
@@ -406,6 +408,47 @@ describe("t-rpc-harness-live", () => {
     10 * 60_000,
   );
 
+  live(
+    "S21: a dispatched developer hands off to the @smol model at its first write (prewalk)",
+    async () => {
+      const dir = project();
+      // An unassigned smol role inherits the default model, which would make the handoff a no-op.
+      const agentDir = agentDirectory();
+      writeFileSync(join(agentDir, "config.yml"), "modelRoles:\n  smol: anthropic/claude-haiku-5-5\n");
+      const rpc = session(dir, undefined, agentDir);
+      await rpc.start();
+      await rpc.prompt(
+        "Call the task tool exactly once with agent `aidlc-developer-agent`, name `Build`, and the assignment " +
+          "`Do these in order, one tool call per turn. 1: call the todo tool to record steps 2-4, and nothing else in that turn. " +
+          "2: write src/a.ts exporting const a = 1. 3: write src/b.ts exporting const b = 2. " +
+          "4: mark the todos done and reply done.` Then stop.",
+        { stopWhen: (frame) => frame.type === "tool_execution_end" && frame.toolName === "task" },
+      );
+      const state = (await rpc.command({ type: "get_state" })).data as { sessionFile?: string };
+      await rpc.close();
+      const artifacts = String(state.sessionFile).replace(/\.jsonl$/, "");
+      const transcript = readdirSync(artifacts, { recursive: true })
+        .map(String)
+        .find((name) => /(^|\/)Build\.jsonl$/.test(name));
+      expect(transcript, readdirSync(artifacts, { recursive: true }).join(", ")).toBeDefined();
+      const turns = readFileSync(join(artifacts, transcript!), "utf-8")
+        .split("\n")
+        .filter(Boolean)
+        .map((line) => JSON.parse(line) as { type?: string; message?: { role?: string; model?: string; content?: Array<{ type?: string; name?: string }> } })
+        .filter((entry) => entry.type === "message" && entry.message?.role === "assistant")
+        .map((entry) => ({
+          model: String(entry.message?.model ?? ""),
+          writes: (entry.message?.content ?? []).some((part) => part.type === "toolCall" && (part.name === "write" || part.name === "edit")),
+        }));
+      const firstWrite = turns.findIndex((turn) => turn.writes);
+      expect(firstWrite, JSON.stringify(turns)).toBeGreaterThan(-1);
+      // The planning model makes the first write; the turns after it run on the @smol model.
+      expect(turns[firstWrite].model, JSON.stringify(turns)).not.toContain("haiku");
+      expect(turns.slice(firstWrite + 1).some((turn) => turn.model.includes("haiku")), JSON.stringify(turns)).toBe(true);
+    },
+    10 * 60_000,
+  );
+
   live(
     "S20: /aidlc-checkers records the project's lint and test commands, and a bad write fails project-checks with feedback",
     async () => {
