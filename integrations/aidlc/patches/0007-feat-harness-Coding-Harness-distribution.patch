+// harness/harness/manifest.ts — the Coding Harness distribution row.
+//
+// Projects the harness-neutral core/ tree into dist/harness/.harness-aidlc/ and
+// defers every harness-native surface to emit.ts. Verified live against Coding
+// Harness 1.1.0.
+//
+// Coding Harness specifics vs Claude:
+//   - token → .harness-aidlc. The engine needs a directory of its own: `.harness/`
+//     is the user's harness configuration, and `.aidlc/` is AI-DLC's workspace
+//     state. Nothing in .harness-aidlc/ is scanned by the harness on its own.
+//   - The only file AI-DLC places under `.harness/` is the bootstrap
+//     `.harness/extensions/aidlc.ts` (whole-file root integration, written by
+//     emit.ts). The harness auto-loads project extensions from there; the
+//     bootstrap re-exports host/adapter.ts, which maps harness events onto the
+//     core hooks and contributes the distribution's resources through
+//     `resources_discover`: skills (.harness-aidlc/skills), the /aidlc prompt
+//     (host/prompts), the 14 persona agents (host/agents), stream rules
+//     (host/rules) and advisor guidance (host/watchdog).
+//   - The method tree reaches ambient context through the adapter, which injects
+//     the files listed in host/includes.json into the system prompt; a space
+//     switch re-points that file (aidlc-includes.ts).
+//   - The harness reads the project-root AGENTS.md as a context file.
+
+import type { HarnessManifest } from "../../scripts/manifest-types.ts";
+import onboardingFills from "./onboarding.fills.ts";
+import emit from "./emit.ts";
+
+const manifest: HarnessManifest = {
+  name: "harness",
+  productName: "Coding Harness",
+  configNextStep: "run `harness` in this project, then `/aidlc --doctor`",
+  harnessDir: ".harness-aidlc",
+  orchestratorSkillPath: ".harness-aidlc/skills/aidlc/SKILL.md",
+  tierFlavor: "harness",
+  rootIntegrations: [
+    { path: ".gitignore", policy: "managed-block", marker: "gitignore", shared: "union" },
+    { path: "AGENTS.md", policy: "managed-block", marker: "agents", shared: "identical" },
+    { path: ".harness/extensions/aidlc.ts", policy: "whole-file" },
+  ],
+
+  // Same core projection as opencode. The persona .md files ARE core (the
+  // conductor adopts them inline from .harness-aidlc/agents/); the harness-native
+  // agent definitions in host/agents/ are emitted.
+  coreDirs: [
+    { src: "tools", dst: "tools" },
+    { src: "aidlc-common", dst: "aidlc-common" },
+    { src: "knowledge", dst: "knowledge" },
+    { src: "sensors", dst: "sensors" },
+    { src: "scopes", dst: "scopes" },
+    { src: "agents", dst: "agents" },
+    { src: "hooks", dst: "hooks" },
+    { src: "skills/aidlc-session-cost", dst: "skills/aidlc-session-cost" },
+    { src: "skills/aidlc-replay", dst: "skills/aidlc-replay" },
+    { src: "skills/aidlc-outcomes-pack", dst: "skills/aidlc-outcomes-pack" },
+    { src: "skills/aidlc-knowledge", dst: "skills/aidlc-knowledge" },
+  ],
+
+  // The orchestrator SKILL.md is derived from the Claude distribution's by emit.ts
+  // (same text, harness tool vocabulary), so it follows Claude's skill on every change.
+  harnessFiles: [
+    { src: "skills/aidlc/question-rendering.md", dst: "skills/aidlc/question-rendering.md" },
+    { src: "dot-gitignore", dst: ".gitignore", projectRoot: true },
+  ],
+
+  // Neutral root guidance is shared; the adapter injects the native setup from onboarding.md.
+  onboarding: { dst: "AGENTS.md", projectRoot: true, harnessDst: "onboarding.md", fills: onboardingFills },
+
+  // .harness-aidlc/ is AI-DLC's own dir; core's rules/ name has nothing to collide with.
+  rulesRename: null,
+
+  emit,
+
+  // Host plugin projection: plugins compose into the engine directory and their
+  // agents into host/agents, which the adapter contributes to task discovery.
+  plugin: {
+    manifestDir: ".harness-aidlc-plugin",
+    kind: "store",
+    installRoots: [".harness"],
+  },
+};
+
+export default manifest;
