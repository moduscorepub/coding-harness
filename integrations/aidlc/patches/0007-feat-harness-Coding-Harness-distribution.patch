+// harness/harness/onboarding.fills.ts — Coding Harness onboarding-doc fills.
+// The packager fills core/templates/onboarding-harness.md into
+// dist/harness/.harness-aidlc/onboarding.md, which the adapter injects into the
+// system prompt. The root AGENTS.md stays neutral, identical to the other sharing harnesses.
+
+import type { OnboardingFills } from "../../scripts/onboarding.ts";
+
+const fills: OnboardingFills = {
+  invoke: "/aidlc",
+  slots: {
+    title_block: `# AI-DLC on Coding Harness
+
+This project uses AI-DLC (AI-Driven Development Life Cycle) for structured development, running on **Coding Harness**. The engine ships in \`.harness-aidlc/\` and a one-line bootstrap in \`.harness/extensions/aidlc.ts\` loads it (no setup command); describe what you want to build and it sets up the workflow for you. Run \`/aidlc\` followed by a scope or project description to begin. Run \`/aidlc --doctor\` to validate your setup, \`/aidlc --version\` to print the framework version, \`/aidlc --stage <slug>\` to jump to a specific stage, \`/aidlc --phase <name>\` to jump to a phase, \`/aidlc --depth <level>\` to override depth, \`/aidlc --test-strategy <level>\` to override test volume, \`/aidlc --review <class>\` to cap stage reviews (adversarial, advisory, none). Run \`/aidlc compose "<task>"\` to get a plan tailored to one task.`,
+
+    prereq_bullets: `- **Coding Harness ≥ 1.1.0**: the adapter relies on the \`resources_discover\` extension seam (skills, prompts, agents, rules and advisor guidance contributed from \`.harness-aidlc/\`). Check with \`harness --version\`.
+- **bun**: Required for the CLI tools and hook scripts (tracking progress, writing the decision log, deciding what runs next), which run as \`bun .harness-aidlc/tools/aidlc.ts\`. Install via \`curl -fsSL https://bun.sh/install | bash\` and keep \`bun\` on the PATH Coding Harness inherits.
+- **Model access**: Coding Harness owns provider credentials and model selection. Persona agents carry \`model\` and \`thinkingLevel\` frontmatter that \`aidlc config models\` maintains; the harness resolves them against your authenticated providers.
+- **Project root**: start \`harness\` from the project root so the bootstrap in \`.harness/extensions/\` loads. Keep \`.harness/extensions/aidlc.ts\` and \`.harness-aidlc/\` committed; harness discovery skips gitignored paths.`,
+
+    prereq_bullets_tail: "",
+
+    agents_note: `On Coding Harness each expert role is a native task agent (\`.harness-aidlc/host/agents/aidlc-<role>-agent.md\`, contributed to task discovery by the adapter); the \`/aidlc\` session takes on those roles itself for most stages and hands work off via the \`task\` tool for the delegated stages.`,
+
+    structure_extra: "",
+
+    sections_before_resumption: `## What's different on this harness
+
+This is the same AI-DLC core that ships to every harness: the same ordered steps, the same approval gates, and the same written record of what was decided, rendered onto Coding Harness. On Coding Harness:
+
+- Approval gates and questions render through the **\`ask\` tool** (structured options; the UI adds "Other"). No question opens with an option pre-selected.
+- Hooks ride the **AI-DLC adapter extension** (\`.harness-aidlc/host/adapter.ts\`, loaded by \`.harness/extensions/aidlc.ts\`): stage-rule delivery, plan-approval, review-freeze, reviewer read-scope and state-transition guards run before tools; audit and sensors run after writes and edits; the forwarding loop (Stop) blocks and continues natively; session start, session end and pre-compaction validation fire like on Claude Code.
+- **Sensor results reach the model**: after a write, failing sensor findings arrive as context right after the tool result, so the agent can fix them in the same turn. Set \`AIDLC_HARNESS_SENSOR_FEEDBACK=0\` to turn this off; the audit trail is identical either way.
+- The AI-DLC method (\`aidlc/spaces/<space>/memory/*.md\`) reaches the system prompt through the adapter, from \`.harness-aidlc/host/includes.json\`; \`/aidlc space <name>\` re-points that file.
+- The **status line** shows the AI-DLC position (\`aidlc\` segment); use \`/aidlc --status\` for detail.
+- A workflow's \`aidlc/\` workspace tree is harness-neutral: a project can carry the Claude Code and Coding Harness distributions side by side.
+`,
+
+    sections_after_resumption: "",
+  },
+};
+
+export default fills;
